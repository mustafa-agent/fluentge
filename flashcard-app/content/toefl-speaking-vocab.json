[
  {"english": "In my opinion", "georgian": "ჩემი აზრით", "pronunciation": "/ɪn maɪ əˈpɪnjən/", "example_en": "In my opinion, education is the key.", "example_ka": "ჩემი აზრით, განათლება მთავარია.", "category": "toefl-speaking", "level": "B1"},
  {"english": "I strongly believe", "georgian": "მტკიცედ მჯერა", "pronunciation": "/aɪ ˈstrɒŋli bɪˈliːv/", "example_en": "I strongly believe that exercise is important.", "example_ka": "მტკიცედ მჯერა, რომ ვარჯიში მნიშვნელოვანია.", "category": "toefl-speaking", "level": "B1"},
  {"english": "For instance", "georgian": "მაგალითად", "pronunciation": "/fɔːr ˈɪnstəns/", "example_en": "For instance, many students study abroad.", "example_ka": "მაგალითად, ბევრი სტუდენტი საზღვარგარეთ სწავლობს.", "category": "toefl-speaking", "level": "B1"},
  {"english": "On the other hand", "georgian": "მეორე მხრივ", "pronunciation": "/ɒn ðə ˈʌðər hænd/", "example_en": "On the other hand, cities offer more jobs.", "example_ka": "მეორე მხრივ, ქალაქებში მეტი სამუშაოა.", "category": "toefl-speaking", "level": "B1"},
  {"english": "To sum up", "georgian": "შეჯამებისთვის", "pronunciation": "/tuː sʌm ʌp/", "example_en": "To sum up, I prefer learning online.", "example_ka": "შეჯამებისთვის, ონლაინ სწავლას ვამჯობინებ.", "category": "toefl-speaking", "level": "B1"},
  {"english": "That being said", "georgian": "ამის მიუხედავად", "pronunciation": "/ðæt ˈbiːɪŋ sed/", "example_en": "That being said, there are some drawbacks.", "example_ka": "ამის მიუხედავად, ნაკლოვანებებიც არსებობს.", "category": "toefl-speaking", "level": "B2"},
  {"english": "It goes without saying", "georgian": "უთუოდ", "pronunciation": "/ɪt ɡoʊz wɪðˈaʊt ˈseɪɪŋ/", "example_en": "It goes without saying that health comes first.", "example_ka": "უთუოდ, ჯანმრთელობა პირველ ადგილზეა.", "category": "toefl-speaking", "level": "B2"},
  {"english": "As a matter of fact", "georgian": "სინამდვილეში", "pronunciation": "/æz ə ˈmætər əv fækt/", "example_en": "As a matter of fact, I've been there twice.", "example_ka": "სინამდვილეში, ორჯერ ვყოფილვარ იქ.", "category": "toefl-speaking", "level": "B2"},
  {"english": "By and large", "georgian": "ზოგადად", "pronunciation": "/baɪ ənd lɑːrdʒ/", "example_en": "By and large, the project was successful.", "example_ka": "ზოგადად, პროექტი წარმატებული იყო.", "category": "toefl-speaking", "level": "B2"},
  {"english": "From my point of view", "georgian": "ჩემი თვალსაზრისით", "pronunciation": "/frɒm maɪ pɔɪnt əv vjuː/", "example_en": "From my point of view, teamwork is essential.", "example_ka": "ჩემი თვალსაზრისით, გუნდური მუშაობა აუცილებელია.", "category": "toefl-speaking", "level": "B1"},
  {"english": "Elaborate", "georgian": "დეტალურად ახსნა", "pronunciation": "/ɪˈlæbəreɪt/", "example_en": "Let me elaborate on this topic.", "example_ka": "ამ თემაზე დეტალურად ავხსნი.", "category": "toefl-speaking", "level": "B2"},
