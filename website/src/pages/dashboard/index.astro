---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="დეშბორდი — FluentGe">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="font-['Playfair_Display',serif] text-3xl font-bold mb-2 text-center">📊 დეშბორდი</h1>
    <p class="text-[#A0A09A] text-center mb-10">შენი XP და რეიტინგი</p>

    <!-- XP Stats -->
    <div class="mb-8">
      <div class="bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border border-indigo-500/20 rounded-2xl p-6">
        <div class="grid grid-cols-2 gap-4 mb-5">
          <div class="text-center">
            <p class="text-3xl font-bold text-indigo-400" id="total-xp">0</p>
            <p class="text-[#6B6B65] text-xs mt-1">სულ XP</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-amber-400" id="current-level">Lv.1</p>
            <p class="text-[#6B6B65] text-xs mt-1">დონე</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-green-400" id="today-xp">+0</p>
            <p class="text-[#6B6B65] text-xs mt-1">დღეს მოგროვებული</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-orange-400" id="streak-count">0</p>
            <p class="text-[#6B6B65] text-xs mt-1">🔥 სერია</p>
          </div>
        </div>
        <!-- XP Progress Bar -->
        <div>
          <div class="flex justify-between text-sm mb-2">
            <span id="level-label" class="text-[#A0A09A]">დონე 1</span>
            <span id="xp-progress-text" class="text-[#A0A09A]">0/200 XP</span>
          </div>
          <div class="w-full bg-[#1C1C1E] rounded-full h-3">
            <div id="xp-bar" class="bg-gradient-to-r from-indigo-500 to-purple-500 h-3 rounded-full transition-all" style="width:0%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Weekly Leaderboard -->
    <div class="mb-8">
      <h2 class="font-bold text-lg mb-4 flex items-center gap-2">🏆 კვირის ლიდერბორდი</h2>
      <div class="bg-[#242426] border border-[#2E2E30] rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500/10 to-yellow-500/10 px-4 py-3 border-b border-[#2E2E30] flex items-center justify-between">
          <span class="text-xs text-amber-400 font-semibold">ამ კვირის რეიტინგი</span>
          <span class="text-xs text-[var(--color-text-muted)]">ორშაბათს ახლდება</span>
        </div>
        <div id="leaderboard-list" class="divide-y divide-[#2E2E30]"></div>
      </div>
    </div>
    <!-- Reset XP -->
    <div class="mt-8 text-center">
      <button id="reset-xp-btn" class="text-xs text-red-400/60 hover:text-red-400 transition-colors" onclick="if(confirm('ნამდვილად გსურს XP-ის განულება?')){localStorage.setItem('totalXP','0');localStorage.removeItem('fluentge-daily-history');localStorage.removeItem('currentStreak');localStorage.removeItem('lastPracticeDate');location.reload();}">
        🔄 XP-ის განულება
      </button>
    </div>
  </section>

  <script is:inline>
    (function() {
      // XP Stats
      var totalXP = parseInt(localStorage.getItem('totalXP') || '0', 10);
      var level = Math.floor(totalXP / 200) + 1;
      var xpInLevel = totalXP - (level - 1) * 200;

      // Today's XP
      var todayXP = 0;
      var todayStr = new Date().toDateString();
      try {
        var tg = JSON.parse(localStorage.getItem('todayGames') || '{}');
        if (tg.date === todayStr) todayXP += (tg.xp || 0);
      } catch(e) {}
      try {
        var dh = JSON.parse(localStorage.getItem('fluentge-daily-history') || '{}');
        var todayKey = new Date().toISOString().slice(0, 10);
        if (dh[todayKey]) todayXP += (typeof dh[todayKey] === 'object' ? (dh[todayKey].xp || 0) : 0);
      } catch(e) {}

      // Streak
      var streak = 0;
      try {
        var hist = JSON.parse(localStorage.getItem('fluentge-daily-history') || '{}');
        var d = new Date();
        while (true) {
          var key = d.toISOString().slice(0, 10);
          if (hist[key]) { streak++; d.setDate(d.getDate() - 1); }
          else break;
        }
      } catch(e) {}

      document.getElementById('total-xp').textContent = totalXP;
      document.getElementById('current-level').textContent = 'Lv.' + level;
      document.getElementById('today-xp').textContent = '+' + todayXP;
      document.getElementById('streak-count').textContent = streak;
      document.getElementById('level-label').textContent = 'დონე ' + level;
      document.getElementById('xp-progress-text').textContent = xpInLevel + '/200 XP';
      document.getElementById('xp-bar').style.width = Math.min(100, (xpInLevel / 200) * 100) + '%';

      // --- Weekly Leaderboard ---
      var simulatedUsers = [
        { name: 'ნიკა მ.', avatar: '🧑‍💻', baseXP: 180 },
        { name: 'მარიამი თ.', avatar: '👩‍🎓', baseXP: 155 },
        { name: 'გიორგი კ.', avatar: '🧠', baseXP: 140 },
        { name: 'ანა ბ.', avatar: '💪', baseXP: 120 },
        { name: 'დავითი ჯ.', avatar: '🔥', baseXP: 100 },
        { name: 'ელენე ს.', avatar: '⭐', baseXP: 85 },
        { name: 'ლუკა ხ.', avatar: '🚀', baseXP: 70 },
        { name: 'თეკლე გ.', avatar: '📚', baseXP: 55 },
        { name: 'ირაკლი პ.', avatar: '🎯', baseXP: 40 },
      ];
      var weekNum = Math.floor((Date.now() - new Date(2026, 0, 5).getTime()) / (7 * 24 * 60 * 60 * 1000));
      function seededRandom(seed) { var x = Math.sin(seed) * 10000; return x - Math.floor(x); }
      simulatedUsers.forEach(function(u, i) {
        var variation = seededRandom(weekNum * 100 + i) * 60 - 20;
        u.weeklyXP = Math.max(10, Math.round(u.baseXP + variation));
      });

      // User's weekly XP
      var userWeeklyXP = 0;
      try {
        var dailyHist = JSON.parse(localStorage.getItem('fluentge-daily-history') || '{}');
        var today2 = new Date();
        var dayOfWeek = today2.getDay() === 0 ? 7 : today2.getDay();
        for (var d2 = 0; d2 < dayOfWeek; d2++) {
          var dateObj = new Date(today2);
          dateObj.setDate(today2.getDate() - d2);
          var dateKey = dateObj.toISOString().slice(0, 10);
          var dayData = dailyHist[dateKey];
          if (dayData) userWeeklyXP += typeof dayData === 'object' ? (dayData.xp || 0) : dayData;
        }
      } catch(e) {}

      var allPlayers = simulatedUsers.map(function(u) {
        return { name: u.name, avatar: u.avatar, xp: u.weeklyXP, isUser: false };
      });
      var userName = 'შენ';
      try {
        var ud = JSON.parse(localStorage.getItem('fluentge-user') || '{}');
        if (ud.name) userName = ud.name;
      } catch(e) {}
      var savedAvatar = localStorage.getItem('fluentge-avatar') || '😊';
      allPlayers.push({ name: userName, avatar: savedAvatar, xp: userWeeklyXP, isUser: true });
      allPlayers.sort(function(a, b) { return b.xp - a.xp; });

      var lbList = document.getElementById('leaderboard-list');
      allPlayers.slice(0, 10).forEach(function(p, idx) {
        var rank = idx + 1;
        var medals = ['', '🥇', '🥈', '🥉'];
        var medal = medals[rank] || '';
        var row = document.createElement('div');
        row.className = 'flex items-center gap-3 px-4 py-3' + (p.isUser ? ' bg-green-500/10 border-l-3 border-green-500' : '');
        row.innerHTML =
          '<span class="w-6 text-center text-sm font-bold ' + (rank <= 3 ? 'text-amber-400' : 'text-[var(--color-text-muted)]') + '">' + (medal || rank) + '</span>' +
          '<div class="w-9 h-9 rounded-full bg-gradient-to-br ' +
            (rank === 1 ? 'from-amber-400 to-yellow-500' : rank === 2 ? 'from-gray-300 to-gray-400' : rank === 3 ? 'from-amber-600 to-amber-700' : 'from-[#3a3a3e] to-[#2a2a2e]') +
            ' flex items-center justify-center text-lg flex-shrink-0">' + p.avatar + '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<span class="text-sm font-semibold ' + (p.isUser ? 'text-green-400' : '') + '">' + p.name + (p.isUser ? ' (შენ)' : '') + '</span>' +
          '</div>' +
          '<span class="text-sm font-bold ' + (rank <= 3 ? 'text-amber-400' : 'text-[var(--color-text-muted)]') + '">' + p.xp + ' XP</span>';
        lbList.appendChild(row);
      });
    })();
  </script>
</Layout>
