---
import Layout from '../layouts/Layout.astro';
---

<Layout title="დახმარების ცენტრი | FluentGe" description="FluentGe-ს დახმარების ცენტრი — ხშირად დასმული კითხვები, მხარდაჭერა და საკონტაქტო ინფორმაცია.">
  <style>
    .help-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
      position: relative;
      overflow: hidden;
    }
    .help-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(99,102,241,0.15) 0%, transparent 60%);
    }
    .faq-item {
      background: #1e1e22;
      border: 1px solid #2e2e32;
      border-radius: 1rem;
      overflow: hidden;
      transition: border-color 0.3s;
    }
    .faq-item:hover {
      border-color: #4a4a50;
    }
    .faq-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      background: none;
      border: none;
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
      gap: 1rem;
    }
    .faq-btn:hover { color: #818cf8; }
    .faq-icon {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      transition: transform 0.3s;
      color: #818cf8;
    }
    .faq-item.open .faq-icon {
      transform: rotate(45deg);
    }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
    }
    .faq-item.open .faq-answer {
      max-height: 500px;
    }
    .faq-answer-inner {
      padding: 0 1.5rem 1.25rem;
      color: #a0a0a0;
      font-size: 0.925rem;
      line-height: 1.7;
    }
    .contact-card {
      background: linear-gradient(135deg, #1e1b4b 0%, #1e1e22 100%);
      border: 1px solid #2e2e32;
      border-radius: 1.25rem;
      padding: 2.5rem;
      text-align: center;
    }
    .contact-btn {
      display: inline-block;
      padding: 14px 32px;
      background: linear-gradient(135deg, #818cf8, #6366f1);
      color: white;
      font-weight: 700;
      border-radius: 0.75rem;
      text-decoration: none;
      transition: all 0.2s;
      border-bottom: 4px solid #4f46e5;
    }
    .contact-btn:hover { background: linear-gradient(135deg, #6366f1, #4f46e5); }
    .contact-btn:active { border-bottom-width: 2px; transform: translateY(2px); }
  </style>

  <!-- Hero -->
  <section class="help-hero pt-28 pb-16 px-4">
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="text-4xl mb-4">💡</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">დახმარების ცენტრი</h1>
      <p class="text-[#a0a0a0] text-lg max-w-xl mx-auto">იპოვე პასუხები ხშირად დასმულ კითხვებზე და გაიგე მეტი FluentGe-ს შესახებ.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 pb-20">
    <div class="flex flex-col gap-3">

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>🎓 რა არის FluentGe?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            FluentGe არის პირველი და ერთადერთი ინგლისური ენის სასწავლო აპლიკაცია, რომელიც სპეციალურად ქართველებისთვის შეიქმნა. აპლიკაცია მოიცავს 5,250+ სიტყვას, 65 გრამატიკის გაკვეთილს, 35 პოდკასტს, 1,695 ფრაზას აუდიოთი, 30+ თამაშს და 12 სასწავლო რეჟიმს. ყველაფერი ქართულ ენაზეა ახსნილი.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>🚀 როგორ დავიწყო სწავლა?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            უბრალოდ ჩამოტვირთე აპლიკაცია, შექმენი ანგარიში და დაიწყე სწავლა! გირჩევთ დაიწყოთ ყოველდღიური გაკვეთილით — ის ავტომატურად შეგირჩევთ თქვენი დონის შესაბამის მასალას. ასევე შეგიძლიათ გაიაროთ განთავსების ტესტი, რომ აპლიკაციამ ზუსტად განსაზღვროს თქვენი დონე.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>💎 რა ღირს პრემიუმი?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            FluentGe-ს აქვს უფასო ვერსია, რომელიც მოიცავს ბევრ ფუნქციას. პრემიუმ გამოწერა იწყება $6.67-დან თვეში (წლიური პლანით). პრემიუმი გაძლევთ შეუზღუდავ წვდომას ყველა სიტყვაზე, გრამატიკის გაკვეთილზე, თამაშზე, პოდკასტზე და სხვა ფუნქციებზე. დეტალებისთვის ეწვიეთ <a href="/premium/" class="text-[#818cf8] hover:underline">პრემიუმის გვერდს</a>.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>📝 როგორ მუშაობს რთული სიტყვები?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            როცა რომელიმე სიტყვას ვერ იმახსოვრებთ, შეგიძლიათ მონიშნოთ ის „რთულად". ეს სიტყვები ავტომატურად შეგროვდება ცალკე სექციაში, სადაც შეძლებთ მათ განმეორებით გავარჯიშებას. სისტემა იყენებს ინტერვალური გამეორების მეთოდს, რომ ეფექტურად დაგეხმაროთ დამახსოვრებაში.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>🎮 როგორ ვითამაშო თამაშები?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            FluentGe-ში 30-ზე მეტი სასწავლო თამაშია! გადადით თამაშების სექციაში და აირჩიეთ სასურველი თამაში. თამაშები მოიცავს სიტყვების შეჯიბრს, კროსვორდებს, ჰენგმენს, მეხსიერების თამაშს და მრავალ სხვას. თამაშები სწავლას სახალისოს და ეფექტურს ხდის!
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>📶 შემიძლია ოფლაინ გამოყენება?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            დიახ! FluentGe-ს ძირითადი ფუნქციები ხელმისაწვდომია ინტერნეტის გარეშეც. ფლეშბარათები, გრამატიკის გაკვეთილები და ზოგიერთი თამაში მუშაობს ოფლაინ რეჟიმში. პოდკასტების და ზოგიერთი ფუნქციის გამოყენებისთვის ინტერნეტ კავშირი საჭიროა.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>💬 როგორ დავუკავშირდე მხარდაჭერას?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            შეგიძლიათ დაგვიკავშირდეთ ელ-ფოსტით: <a href="mailto:support@fluentge.com" class="text-[#818cf8] hover:underline">support@fluentge.com</a>. ჩვენი გუნდი ჩვეულებრივ 24 საათის განმავლობაში პასუხობს. ასევე შეგიძლიათ დატოვოთ შეტყობინება აპლიკაციის „უკუკავშირი" სექციაში.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-btn" onclick="this.parentElement.classList.toggle('open')">
          <span>📱 რა მოწყობილობებზე მუშაობს?</span>
          <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            FluentGe ხელმისაწვდომია Android მოწყობილობებზე Google Play Store-დან. ვებ ვერსია მუშაობს ნებისმიერ ბრაუზერში — კომპიუტერზე, ტაბლეტზე და ტელეფონზე. iOS ვერსია მალე დაემატება!
          </div>
        </div>
      </div>

    </div>

    <!-- Contact Section -->
    <div class="contact-card mt-16">
      <div class="text-3xl mb-4">✉️</div>
      <h2 class="text-2xl font-bold text-white mb-3">კიდევ გაქვთ კითხვა?</h2>
      <p class="text-[#a0a0a0] mb-6 max-w-md mx-auto">ჩვენი გუნდი მზად არის დაგეხმაროთ. მოგვწერეთ და მალე მიიღებთ პასუხს.</p>
      <a href="mailto:support@fluentge.com" class="contact-btn">📧 support@fluentge.com</a>
    </div>
  </section>
</Layout>
