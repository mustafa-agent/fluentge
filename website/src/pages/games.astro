          <p style="color:#A0A09A;margin-bottom:20px;">${speedTime} წამში რამდენს თარგმნი?</p>
          <button id="sg" style="display:block;width:100%;padding:18px;border-radius:16px;background:linear-gradient(135deg,#16a34a,#059669);border:none;border-bottom:5px solid #15803d;font-weight:800;color:white;font-size:1.3rem;cursor:pointer;min-height:60px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">▶ START</button>
        </div>
        <div id="sp" class="hidden">
          <div id="speed-timer-ring" style="width:64px;height:64px;border-radius:50%;border:4px solid #333;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:1.5rem;font-weight:900;color:#F59E0B;"></div>
          <p id="sw" style="font-size:2rem;font-weight:800;text-align:center;margin-bottom:16px;color:#F5F5F0;"></p>
          <div id="so" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"></div>
        </div>
      `;

      layout.controls.innerHTML = '';
      
      function go(){
        sc=0;tl=speedTime;gameStarted=true;
        updateGameScore(0);
        updateGameTimer(speedTime);
        document.getElementById('ss').classList.add('hidden');
        document.getElementById('sp').classList.remove('hidden');
        document.getElementById('sg').style.display = 'none';
        const ring=document.getElementById('speed-timer-ring');if(ring){ring.textContent=speedTime;ring.style.borderColor='#10B981';}
        
        if(si)clearInterval(si);
        si=setInterval(()=>{
          tl--;
          updateGameTimer(tl);
          const ring=document.getElementById('speed-timer-ring');
          if(ring){ring.textContent=tl;ring.style.borderColor=tl<=10?'#EF4444':tl<=20?'#F59E0B':'#10B981';if(tl<=5)ring.style.animation='pulse 0.5s ease infinite';}
          if(tl<=0){
            clearInterval(si);
            end();
          }
        },1000);
        nxt();
      }
      
      function nxt(){
        if(!gameStarted) return;
        const c=rw(),wr=sh(W.filter(w=>w.en!==c.en)).slice(0,3),opts=sh([c,...wr]);
        document.getElementById('sw').textContent=c.en;
        const d=document.getElementById('so');
        d.innerHTML='';
        opts.forEach(o=>{
          const b=document.createElement('button');
          b.textContent=o.ka;
          b.style.cssText='display:flex;align-items:center;justify-content:center;padding:16px 8px;min-height:56px;border-radius:16px;border:2px solid #4A4A50;border-bottom:5px solid #1A1A1C;background:linear-gradient(180deg,#404048,#343438,#2A2A2E);color:#F5F5F0;font-weight:700;font-size:1rem;cursor:pointer;transition:all 0.15s;-webkit-tap-highlight-color:transparent;touch-action:manipulation;box-shadow:0 6px 16px rgba(0,0,0,0.5),inset 0 2px 0 rgba(255,255,255,0.12);';
          const handler=()=>{
            if(o.en===c.en){
              snd(1);sc++;updateGameScore(sc);
              b.style.background='linear-gradient(180deg,#34d399,#22c55e,#16a34a)';b.style.borderColor='#6ee7b7';b.style.borderBottomColor='#0f5132';b.style.color='white';b.style.boxShadow='0 6px 30px rgba(34,197,94,0.6)';b.style.animation='correctPop 0.4s ease';
            }else{
              snd(0);
              b.style.background='linear-gradient(180deg,#f87171,#ef4444,#dc2626)';b.style.borderColor='#fca5a5';b.style.borderBottomColor='#7f1d1d';b.style.color='white';b.style.boxShadow='0 6px 30px rgba(239,68,68,0.5)';b.style.animation='shake3d 0.4s ease';
            }
            setTimeout(nxt,350);
          };
          b.addEventListener('click',handler);
          b.addEventListener('touchstart',function(e){e.preventDefault();handler();},{passive:false});
          d.appendChild(b);
        });
      }
      
      function end(){
        gameStarted = false;
        const isNew = checkRecord('speed',sc);
        const message = sc>=15?'ჩემპიონი!':sc>=10?'შესანიშნავი!':sc>=5?'კარგია!':'ივარჯიშე!';
        
        setTimeout(() => {
          showGameCompletion({
            score: sc,
            time: '30წმ',
