          const handler=()=>{
            ec.querySelectorAll('button').forEach(x=>{x.style.borderColor='#4A4A50';x.style.boxShadow='0 6px 16px rgba(0,0,0,0.5),inset 0 2px 0 rgba(255,255,255,0.12)';x.style.background='linear-gradient(180deg,#404048,#343438,#2A2A2E)';});
            b.style.borderColor='#58A6FF';b.style.boxShadow='0 0 20px rgba(88,166,255,0.5),inset 0 2px 0 rgba(255,255,255,0.15)';b.style.background='linear-gradient(180deg,#1E3A5F,#162D4D)';
            selE={b,w:w.en};chk();
          };
          b.addEventListener('click',handler);
          b.addEventListener('touchstart',handler,{passive:true});
          ec.appendChild(b);
        });
        
        ks.forEach(w=>{
          const b=document.createElement('button');
          b.textContent=w.ka;
          b.style.cssText='display:flex;align-items:center;justify-content:center;width:100%;padding:14px 8px;min-height:52px;border-radius:14px;border:2px solid #4A4A50;border-bottom:5px solid #1A1A1C;background:linear-gradient(180deg,#404048,#343438,#2A2A2E);color:#F5F5F0;font-weight:700;font-size:0.95rem;cursor:pointer;transition:all 0.15s;-webkit-tap-highlight-color:transparent;touch-action:manipulation;box-shadow:0 6px 16px rgba(0,0,0,0.5),inset 0 2px 0 rgba(255,255,255,0.12);';
          const handler=()=>{
            kc.querySelectorAll('button').forEach(x=>{x.style.borderColor='#4A4A50';x.style.boxShadow='0 6px 16px rgba(0,0,0,0.5),inset 0 2px 0 rgba(255,255,255,0.12)';x.style.background='linear-gradient(180deg,#404048,#343438,#2A2A2E)';});
            b.style.borderColor='#F59E0B';b.style.boxShadow='0 0 20px rgba(245,158,11,0.5),inset 0 2px 0 rgba(255,255,255,0.15)';b.style.background='linear-gradient(180deg,#3D2E0A,#2D1F06)';
            selK={b,w:w.en};chk();
          };
          b.addEventListener('click',handler);
          b.addEventListener('touchstart',handler,{passive:true});
          kc.appendChild(b);
        });
      }
      
      function chk(){
        if(!selE||!selK)return;
        if(selE.w===selK.w){
          snd(1);
