          selK.b.style.borderColor='#10B981';selK.b.style.background='#10B98130';selK.b.style.boxShadow='0 0 12px rgba(16,185,129,0.4)';selK.b.style.pointerEvents='none';
          setTimeout(()=>{selE.b.style.opacity='0';selE.b.style.transform='scale(0.8)';selK.b.style.opacity='0';selK.b.style.transform='scale(0.8)';},400);
          
          if(cnt>=matchCount){
