      border-color: #6ee7b7 !important;
      border-bottom-color: #0f5132 !important;
      color: #fff !important;
      box-shadow: 0 6px 30px rgba(34,197,94,0.6) !important;
    }

    .answer-wrong {
      animation: wrongAnswer 0.5s ease-out;
      background: linear-gradient(180deg,#f87171,#ef4444,#dc2626) !important;
      border-color: #fca5a5 !important;
      border-bottom-color: #7f1d1d !important;
