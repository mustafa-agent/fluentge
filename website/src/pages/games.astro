    function buildSpeed(){
      const layout = createGameLayout('სიჩქარის ქვიზი', '30 წამი გაქვს — რამდენ სიტყვას დაიმახსოვრებ?', 'speed', {hasTimer: true});
      const speedTime = diffTime(30);
      let sc=0,tl=speedTime,si=null,gameStarted=false;
      
      layout.content.innerHTML = `
        <div id="ss" style="text-align:center;padding:20px 0;">
          <div style="width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg,#D97706,#F59E0B);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:3rem;box-shadow:0 8px 30px rgba(217,119,6,0.3);">⚡</div>
