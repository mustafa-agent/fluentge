    // ============ DIFFICULTY SYSTEM ============
    let gameDifficulty = 'medium'; // 'easy' | 'medium' | 'hard'
    function getDifficultyConfig() {
      return {
        easy:   { label: 'მარტივი',  emoji: '🟢', items: 0.6, time: 1.5,  xpMult: 0.8, color: '#22c55e', desc: 'ნაკლები სიტყვა, მეტი დრო' },
        medium: { label: 'საშუალო', emoji: '🟡', items: 1.0, time: 1.0,  xpMult: 1.0, color: '#eab308', desc: 'სტანდარტული სირთულე' },
        hard:   { label: 'რთული',   emoji: '🔴', items: 1.5, time: 0.65, xpMult: 1.5, color: '#ef4444', desc: 'მეტი სიტყვა, ნაკლები დრო' },
      };
    }
    // Get item count adjusted by difficulty
    function diffItems(base) {
      const cfg = getDifficultyConfig()[gameDifficulty];
      return Math.max(3, Math.round(base * cfg.items));
    }
    // Get time adjusted by difficulty
    function diffTime(base) {
      const cfg = getDifficultyConfig()[gameDifficulty];
      return Math.max(5, Math.round(base * cfg.time));
    }
    // Get XP adjusted by difficulty
    function diffXP(base) {
      const cfg = getDifficultyConfig()[gameDifficulty];
      return Math.round(base * cfg.xpMult);
    }

    function showDifficultySelect(id, callback) {
      const gameInfo = GAMES.find(g => g.id === id) || { name: 'თამაში', color: '#C8C8C0' };
      const cfg = getDifficultyConfig();
      const saved = localStorage.getItem('fluentge-game-difficulty') || 'medium';
      let selected = saved;

      // Build DOM manually (no innerHTML for buttons — bulletproof mobile clicks)
      const wrap = document.createElement('div');
      wrap.className = 'max-w-sm mx-auto py-2 text-center';
      wrap.innerHTML = `
        <h2 style="font-size:1.3rem;font-weight:800;margin-bottom:4px;color:#F5F5F0;">${gameInfo.name}</h2>
        <p style="font-size:13px;color:#A0A09A;margin-bottom:12px;">აირჩიე სირთულის დონე</p>
      `;

      const optionsDiv = document.createElement('div');
      optionsDiv.style.cssText = 'display:flex;flex-direction:column;gap:12px;margin-bottom:16px;';

      const allBtns = [];
      Object.entries(cfg).forEach(([key, c]) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('data-diff', key);
        btn.style.cssText = `display:block;width:100%;padding:18px 20px;border-radius:16px;border:3px solid ${key === saved ? c.color : '#2E2E30'};background:${key === saved ? c.color + '20' : '#242426'};cursor:pointer;text-align:left;min-height:72px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;user-select:none;-webkit-user-select:none;transition:all 0.2s;border-bottom-width:6px;`;
        btn.innerHTML = `<div style="display:flex;align-items:center;gap:14px;pointer-events:none;"><span style="font-size:2.2rem;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.3));">${c.emoji}</span><div style="flex:1;"><div style="font-weight:800;color:#F5F5F0;font-size:1.1rem;">${c.label}</div><div style="font-size:13px;color:#A0A09A;margin-top:2px;">${c.desc}</div></div>${key === saved ? '<span style="font-size:11px;background:'+c.color+'30;padding:3px 10px;border-radius:99px;color:'+c.color+';font-weight:700;">ბოლო</span>' : ''}</div>`;

        btn.addEventListener('touchstart', function(e) {
          e.stopPropagation();
          selectDiff(key);
        }, {passive: true});
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          selectDiff(key);
        });

        allBtns.push({el: btn, key, color: c.color});
        optionsDiv.appendChild(btn);
      });

      function selectDiff(key) {
        selected = key;
        allBtns.forEach(b => {
          if (b.key === key) {
            b.el.style.borderColor = b.color;
            b.el.style.background = b.color + '20';
            b.el.style.boxShadow = '0 0 20px ' + b.color + '25';
            b.el.style.transform = 'scale(1.02)';
          } else {
            b.el.style.borderColor = '#2E2E30';
            b.el.style.background = '#242426';
            b.el.style.boxShadow = 'none';
            b.el.style.transform = 'scale(1)';
          }
        });
      }

      wrap.appendChild(optionsDiv);

      const startBtn = document.createElement('button');
      startBtn.type = 'button';
      startBtn.className = 'gm-start';
      startBtn.style.cssText = 'width:100%;padding:14px;border-radius:12px;background:linear-gradient(135deg,#16a34a,#059669);border:none;border-bottom:4px solid #15803d;font-weight:700;color:white;font-size:1.1rem;cursor:pointer;min-height:52px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;';
      startBtn.textContent = '▶ დაწყება';
      startBtn.addEventListener('touchstart', function(e) {
        e.stopPropagation();
        gameDifficulty = selected;
        localStorage.setItem('fluentge-game-difficulty', selected);
        cont.innerHTML = '';
        callback();
      }, {passive: true});
      startBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        gameDifficulty = selected;
        localStorage.setItem('fluentge-game-difficulty', selected);
        cont.innerHTML = '';
        callback();
      });

      wrap.appendChild(startBtn);
      cont.innerHTML = '';
      cont.appendChild(wrap);
    }

    function openGame(id){
      overlay.classList.remove('hidden');
      document.body.style.overflow='hidden';
      // Hide top nav so it doesn't cover game
      var topNav = document.querySelector('nav.fixed');
      if (topNav) topNav.style.display = 'none';
      cont.innerHTML='';
      _gameActive=true;
      
      const b={match:buildMatch,speed:buildSpeed,truefalse:buildTF,scramble:buildScramble,hangman:buildHangman,fillblank:buildFB,emojiquiz:buildEQ,memory:buildMem,typing:buildType,listening:buildListen,opposites:buildOpp,numbers:buildNum,daysmonths:buildDM,countries:buildCountry,foodquiz:buildFood,clothesquiz:buildClothes,rooms:buildRoom,emotionsquiz:buildEmo,family:buildFamily,travel:buildTravel,phrasesquiz:buildPhrases,movies:buildMovies,math:buildMath,routine:buildRoutine,spelling:buildSpelling,wordrace:buildWordRace,colorsquiz:buildColors,timequiz:buildTime,categories:buildCat,wordcatch:buildCatch};
