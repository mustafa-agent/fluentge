      gc.innerHTML=`<div class="text-center mb-5"><button id="lp" class="bg-[#C8C8C0] hover:bg-[#B8B8B0] text-[#1C1C1E] font-bold py-4 px-10 rounded-xl text-base">მოსმენა</button></div><div class="max-w-xs mx-auto mb-3"><input id="li" type="text" placeholder="ჩაწერე..." class="w-full px-4 py-3 rounded-xl bg-[#242426] border border-white/20 text-[#F5F5F0] text-center text-base focus:outline-none focus:border-[#C8C8C0]" autocomplete="off"/></div><div class="flex gap-2 justify-center mb-3"><button id="lc" class="bg-[#C8C8C0] hover:bg-[#B8B8B0] text-[#1C1C1E] px-5 py-2 rounded-lg font-semibold text-sm">შემოწმება</button><button id="ls" class="bg-[#242426] hover:bg-[#2E2E30] text-white px-5 py-2 rounded-lg font-semibold text-sm">გამოტოვება</button></div><div id="lf" class="text-center font-bold mb-2"></div><div class="text-center text-sm"><span class="text-[#C8C8C0] font-bold">ქულა: <span id="lsc">0</span></span></div>`;
      function nw(){w=rw();document.getElementById('li').value='';document.getElementById('lf').innerHTML='';}
      document.getElementById('lp').onclick=()=>{const u=new SpeechSynthesisUtterance(w.en);u.lang='en-US';u.rate=0.8;speechSynthesis.speak(u);};
      document.getElementById('lc').onclick=()=>{if(document.getElementById('li').value.trim().toLowerCase()===w.en.toLowerCase()){snd(1);sc++;document.getElementById('lsc').textContent=sc;checkRecord('listening',sc);document.getElementById('lf').innerHTML=`<p class="text-[#C8C8C0] text-sm">${w.en} (${w.ka})</p>`;setTimeout(nw,1200);}else{snd(0);document.getElementById('lf').innerHTML='<p class="text-[#ef4444] text-sm">სცადე!</p>';}};
      document.getElementById('ls').onclick=()=>{document.getElementById('lf').innerHTML=`<p class="text-[#eab308] text-sm">${w.en} = ${w.ka}</p>`;setTimeout(nw,1500);};
      document.getElementById('li').onkeydown=e=>{if(e.key==='Enter')document.getElementById('lc').click();};
      nw();
    }

    function buildOpp(){buildListQuiz('საპირისპიროები','იპოვე საწინააღმდეგო სიტყვა',opposites,q=>q.a+' ('+q.ka_a+')',q=>q.b,(d,q)=>d.filter(o=>o!==q).map(o=>o.b),'opposites');}
    function buildNum(){buildListQuiz('რიცხვები','რა რიცხვია ეს?',nums,q=>q.en,q=>String(q.n),(d,q)=>d.filter(n=>n.n!==q.n).map(n=>String(n.n)),'numbers');}
