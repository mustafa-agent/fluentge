    // ============ GAME BUILDERS ============
    // Game records system
    function getGameRecords(){try{return JSON.parse(localStorage.getItem('fluentge-game-records')||'{}');}catch(e){return {};}}
    function saveGameRecord(gameId,score){
      const user=localStorage.getItem('fluentge-user');
      if(!user)return false;
      const records=getGameRecords();
      const prev=records[gameId]||0;
      if(score>prev){records[gameId]=score;localStorage.setItem('fluentge-game-records',JSON.stringify(records));return true;}
      return false;
    }
    function getGameRecord(gameId){return getGameRecords()[gameId]||0;}
    function saveLowRecord(gameId,score){
      const user=localStorage.getItem('fluentge-user');
      if(!user)return false;
      const records=getGameRecords();
      const prev=records[gameId];
      if(prev===undefined||score<prev){records[gameId]=score;localStorage.setItem('fluentge-game-records',JSON.stringify(records));return true;}
      return false;
    }
    function checkLowRecord(gameId,score){
      const isNew=saveLowRecord(gameId,score);
      const el=document.getElementById('game-record');
      if(el){el.textContent=score;if(isNew)el.closest('span').classList.add('!text-yellow-400','!border-yellow-400/40');}
      return isNew;
    }

    // gameWrap: simple wrapper used by most game builders
    function gameWrap(title, desc, gameId) {
      const gameInfo = GAMES.find(g => g.id === gameId) || {name: title, desc: desc, color: '#C8C8C0', icon: ''};
      setGameHeader({
        name: gameInfo.name || title,
        description: gameInfo.desc || desc,
        color: gameInfo.color || '#C8C8C0',
        iconSvg: gameInfo.icon,
        hasTimer: false,
        hasProgress: false
      });
      const record = gameId ? getGameRecord(gameId) : 0;
      cont.innerHTML = `<div class="game-container"><div class="game-content"><div id="game-wrap-content"></div></div></div>`;
      return document.getElementById('game-wrap-content');
    }

    function checkRecord(gameId,score){
      const isNew=saveGameRecord(gameId,score);
      // Record display is now handled by the completion screen
      return isNew;
    }

    function buildMatch(){
      const matchCount = diffItems(6);
      const layout = createGameLayout('დაკავშირება', 'დააკავშირე ინგლისური სიტყვა ქართულ თარგმანთან', 'match', {hasTimer: true, hasProgress: true, totalQuestions: matchCount});
      let score=0,timer=0,int,selE=null,selK=null,cnt=0;
      
      layout.content.innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div>
            <div style="text-align:center;font-size:12px;font-weight:700;color:#58A6FF;margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;">🇬🇧 English</div>
            <div id="ec" style="display:flex;flex-direction:column;gap:8px;"></div>
          </div>
          <div>
            <div style="text-align:center;font-size:12px;font-weight:700;color:#F59E0B;margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;">🇬🇪 ქართული</div>
