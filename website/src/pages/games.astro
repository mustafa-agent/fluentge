        const r=sh(W).slice(0,matchCount),es=sh(r),ks=sh(r);
        const ec=document.getElementById('ec'),kc=document.getElementById('kc');
        ec.innerHTML='';kc.innerHTML='';
        
        es.forEach(w=>{
