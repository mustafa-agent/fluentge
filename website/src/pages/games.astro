    function buildClothes(){buildListQuiz('ტანსაცმელი','ტანსაცმლის ლექსიკა',clothes,q=>q.ka,q=>q.en,(d,q)=>d.filter(c=>c.en!==q.en).map(c=>c.en),'clothesquiz');}
