    function buildTF(){
      const layout = createGameLayout('სიმართლე / ტყუილი', 'ეს თარგმანი სწორია?', 'truefalse');
      let sc=0,tot=0,correct,word,answered=false;
      
      layout.content.innerHTML = `
        <div style="text-align:center;padding:10px 0 16px;">
          <p id="te" style="font-size:2rem;font-weight:800;color:#F5F5F0;margin-bottom:6px;"></p>
          <div style="font-size:1.5rem;color:#6B6B65;margin-bottom:6px;">=</div>
          <p id="tk" style="font-size:1.6rem;font-weight:700;color:#58A6FF;margin-bottom:0;"></p>
        </div>
        <div id="tb" style="min-height:36px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
          <button id="tt" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:22px 16px;border-radius:16px;background:linear-gradient(135deg,#10B981,#059669);border:none;border-bottom:6px solid #047857;font-weight:800;color:white;font-size:1.3rem;cursor:pointer;min-height:72px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">
            ✅ სიმართლე
          </button>
          <button id="tf" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:22px 16px;border-radius:16px;background:linear-gradient(135deg,#EF4444,#DC2626);border:none;border-bottom:6px solid #B91C1C;font-weight:800;color:white;font-size:1.3rem;cursor:pointer;min-height:72px;-webkit-tap-highlight-color:transparent;touch-action:manipulation;">
            ❌ ტყუილი
          </button>
        </div>
        <div style="text-align:center;">
          <span style="background:rgba(200,200,192,0.1);border:1px solid rgba(200,200,192,0.2);border-radius:12px;padding:8px 20px;color:#C8C8C0;font-weight:700;display:inline-block;font-size:1rem;">
            ✨ <span id="ts">0</span>/<span id="to">0</span>
          </span>
        </div>
      `;

      layout.controls.innerHTML = '';
      
      function nxt(){
        if(answered) return;
        word=rw();
        const isT=Math.random()>0.4;
        if(isT){
          document.getElementById('tk').textContent=word.ka;
          correct=true;
        }else{
          const wr=W.filter(w=>w.en!==word.en);
          document.getElementById('tk').textContent=wr[Math.floor(Math.random()*wr.length)].ka;
          correct=false;
        }
        document.getElementById('te').textContent=word.en;
        document.getElementById('tb').innerHTML='';
        answered = false;
        
        // Enable buttons
        document.getElementById('tt').disabled = false;
        document.getElementById('tf').disabled = false;
      }
      
      function ans(p){
        if(answered) return;
        answered = true;
        
        tot++;
        document.getElementById('to').textContent=tot;
        
        const trueBtn = document.getElementById('tt');
        const falseBtn = document.getElementById('tf');
        trueBtn.disabled = true;
        falseBtn.disabled = true;
        
        if(p===correct){
          snd(1);
          sc++;
          updateGameScore(sc);
          checkRecord('truefalse',sc);
          const btn = p ? trueBtn : falseBtn;
          showAnswerFeedback(btn, true);
          document.getElementById('tb').innerHTML='<div class="game-feedback game-feedback-success">სწორია! 🎉</div>';
        }else{
          snd(0);
          const btn = p ? trueBtn : falseBtn;
          showAnswerFeedback(btn, false);
          document.getElementById('tb').innerHTML=`<div class="game-feedback game-feedback-error">არასწორია! ${word.en} = ${word.ka}</div>`;
        }
        
        setTimeout(nxt,1500);
      }
      
      document.getElementById('tt').onclick=()=>ans(true);
      document.getElementById('tf').onclick=()=>ans(false);
      nxt();
    }

