    // ============ UTILS ============
    function sh(a){const r=[...a];for(let i=r.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[r[i],r[j]]=[r[j],r[i]];}return r;}
    function rw(){return W[Math.floor(Math.random()*W.length)];}
    let actx=null;
    function snd(ok){try{if(!actx)actx=new(window.AudioContext||window.webkitAudioContext)();if(actx.state==='suspended')actx.resume();const o=actx.createOscillator(),g=actx.createGain();o.connect(g);g.connect(actx.destination);g.gain.setValueAtTime(0.13,actx.currentTime);o.type='sine';if(ok){o.frequency.setValueAtTime(523,actx.currentTime);o.frequency.setValueAtTime(659,actx.currentTime+0.1);}else{o.frequency.setValueAtTime(330,actx.currentTime);o.frequency.setValueAtTime(262,actx.currentTime+0.15);}g.gain.exponentialRampToValueAtTime(0.001,actx.currentTime+0.3);o.start(actx.currentTime);o.stop(actx.currentTime+0.35);}catch(e){}}
    function h(tag,cls='',html=''){const e=document.createElement(tag);e.className=cls;e.innerHTML=html;return e;}

    // ============ GAME UI UTILITIES ============
    function setGameHeader(game) {
      const icon = document.getElementById('gh-icon');
      const title = document.getElementById('gh-title');
      const desc = document.getElementById('gh-desc');
      const score = document.getElementById('gh-score-value');
      const timer = document.getElementById('gh-timer');
      const timerValue = document.getElementById('gh-timer-value');
      const progress = document.getElementById('gh-progress');

      if (icon) {
        if (game.iconSvg) {
          icon.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="${game.color || '#C8C8C0'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${game.iconSvg}</svg>`;
        } else {
          icon.textContent = game.iconEmoji || '🎮';
        }
        icon.style.borderColor = (game.color || '#C8C8C0') + '30';
      }
      if (title) title.textContent = game.name || 'თამაში';
      if (desc) desc.textContent = game.description || '';
      if (score) score.textContent = '0';
      if (timer && game.hasTimer) {
        timer.classList.remove('hidden');
        if (timerValue) timerValue.textContent = '0';
      } else if (timer) {
        timer.classList.add('hidden');
      }
      if (progress && game.hasProgress) {
        progress.classList.remove('hidden');
        updateGameProgress(0, game.totalQuestions || 10);
      } else if (progress) {
        progress.classList.add('hidden');
      }

      // Update XP display
      updateGameXPDisplay();
    }

    function updateGameXPDisplay() {
      const xp = getGamesTotalXP();
      const level = getGamesLevel(xp);
      const xpEl = document.getElementById('gx-xp');
      const levelEl = document.getElementById('gx-level');
      if (xpEl) xpEl.textContent = xp >= 1000 ? (xp/1000).toFixed(1)+'k' : xp;
      if (levelEl) levelEl.textContent = level;
    }

    function updateGameScore(newScore) {
      const scoreEl = document.getElementById('gh-score-value');
      if (scoreEl) {
        scoreEl.textContent = newScore;
        scoreEl.parentElement.style.animation = 'none';
        scoreEl.parentElement.offsetHeight; // Trigger reflow
        scoreEl.parentElement.style.animation = 'scorePopup 0.4s cubic-bezier(0.34,1.56,0.64,1)';
      }
    }

    function updateGameTimer(seconds) {
      const timerEl = document.getElementById('gh-timer-value');
      if (timerEl) {
        timerEl.textContent = seconds;
        if (seconds <= 10) {
          timerEl.parentElement.style.background = 'rgba(220, 38, 38, 0.2)';
          timerEl.parentElement.style.borderColor = 'rgba(220, 38, 38, 0.4)';
        }
      }
    }

    function updateGameProgress(current, total) {
      const currentEl = document.getElementById('gh-progress-current');
      const totalEl = document.getElementById('gh-progress-total');
      const barEl = document.getElementById('gh-progress-bar');
      
      if (currentEl) currentEl.textContent = current;
      if (totalEl) totalEl.textContent = total;
      if (barEl) {
        const percentage = Math.min(100, (current / total) * 100);
        barEl.style.width = percentage + '%';
      }
    }

    function showAnswerFeedback(element, isCorrect, correctAnswer = '') {
      if (!element) return;
      
      element.classList.remove('answer-correct', 'answer-wrong');
      
      if (isCorrect) {
        element.classList.add('answer-correct');
        setTimeout(() => element.classList.remove('answer-correct'), 600);
      } else {
        element.classList.add('answer-wrong');
        setTimeout(() => element.classList.remove('answer-wrong'), 600);
        if (correctAnswer) {
          const feedback = document.createElement('div');
          feedback.className = 'game-feedback game-feedback-error';
          feedback.textContent = correctAnswer;
          element.parentElement.insertBefore(feedback, element.nextSibling);
          setTimeout(() => feedback.remove(), 2000);
        }
      }
    }

    function showGameCompletion(gameData) {
      const modal = document.createElement('div');
      modal.className = 'game-completion';
      
      const statsHtml = [];
      if (gameData.score !== undefined) statsHtml.push(`<div class="text-2xl font-bold text-[#C8C8C0] mb-2">${gameData.score} ქულა</div>`);
      if (gameData.time) statsHtml.push(`<div class="text-sm text-[#A0A09A] mb-1">დრო: ${gameData.time}</div>`);
      if (gameData.accuracy) statsHtml.push(`<div class="text-sm text-[#A0A09A] mb-1">სისწორე: ${gameData.accuracy}%</div>`);
      if (gameData.streak) statsHtml.push(`<div class="text-sm text-[#A0A09A] mb-1">სერია: ${gameData.streak}</div>`);
      
      const xpEarned = gameData.xpEarned || GAME_XP.COMPLETION;
      const message = gameData.isNewRecord ? '🏆 ახალი რეკორდი!' : 
                     gameData.score >= (gameData.target || 10) ? '🎉 შესანიშნავი!' : 
                     '💪 კარგი მცდელობა!';

      modal.innerHTML = `
        <div class="game-completion-card">
          <div class="text-6xl mb-4">${gameData.isNewRecord ? '🏆' : gameData.score >= (gameData.target || 10) ? '🎉' : '💪'}</div>
          <div class="text-xl font-bold text-[#F5F5F0] mb-4">${message}</div>
          ${statsHtml.join('')}
          <div class="bg-[#C8C8C0]/10 border border-[#C8C8C0]/20 rounded-xl p-4 my-4">
            <div class="text-yellow-400 text-lg mb-1">+${xpEarned} XP</div>
            <div class="text-xs text-[#A0A09A]">მიღებული ქულები</div>
          </div>
          <div class="flex gap-3 mt-6">
            <button onclick="this.closest('.game-completion').remove(); location.reload();" class="game-btn game-btn-secondary flex-1">
              თავიდან
            </button>
            <button onclick="this.closest('.game-completion').remove(); document.getElementById('back-btn').click();" class="game-btn game-btn-primary flex-1">
              უკან
            </button>
          </div>
        </div>
      `;
      
      document.body.appendChild(modal);
      
      // Award XP
      if (xpEarned > 0) {
        setTimeout(() => awardGameXP(null, xpEarned), 500);
      }
    }

    function createGameLayout(title, description, gameId, options = {}) {
      const gameInfo = GAMES.find(g => g.id === gameId) || {name: title, desc: description, color: '#C8C8C0'};
      
      setGameHeader({
        name: gameInfo.name,
