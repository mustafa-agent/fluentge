        iconSvg: gameInfo.icon,
        hasTimer: options.hasTimer || false,
        hasProgress: options.hasProgress || false,
        totalQuestions: options.totalQuestions || 10
      });

      const record = gameId ? getGameRecord(gameId) : 0;
      const recordHtml = gameId && record > 0 ? 
        `<div class="bg-[#C8C8C0]/10 border border-[#C8C8C0]/20 rounded-xl px-4 py-2 mb-4">
