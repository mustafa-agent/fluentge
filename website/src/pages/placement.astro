---
import Layout from '../layouts/Layout.astro';

const questionBank = [
  // A1 (12 questions)
  { q: "What ___ your name?", opts: ["is", "are", "am", "do"], ans: 0, level: "A1" },
  { q: "She ___ a teacher.", opts: ["am", "is", "are", "be"], ans: 1, level: "A1" },
  { q: "I have ___ apple.", opts: ["a", "an", "the", "—"], ans: 1, level: "A1" },
  { q: "They ___ from Georgia.", opts: ["is", "am", "are", "be"], ans: 2, level: "A1" },
  { q: "This is ___ book.", opts: ["I", "me", "my", "mine"], ans: 2, level: "A1" },
  { q: "The cat is ___ the table.", opts: ["in", "on", "at", "to"], ans: 1, level: "A1" },
  { q: "We ___ students.", opts: ["is", "am", "are", "be"], ans: 2, level: "A1" },
  { q: "He ___ a car.", opts: ["have", "has", "having", "had"], ans: 1, level: "A1" },
  { q: "I ___ like coffee.", opts: ["doesn't", "don't", "isn't", "not"], ans: 1, level: "A1" },
  { q: "She ___ to school every day.", opts: ["go", "goes", "going", "gone"], ans: 1, level: "A1" },
  { q: "___ you like pizza?", opts: ["Do", "Does", "Are", "Is"], ans: 0, level: "A1" },
  { q: "There ___ two books on the desk.", opts: ["is", "am", "are", "be"], ans: 2, level: "A1" },

  // A2 (12 questions)
  { q: "He ___ to work every day.", opts: ["go", "goes", "going", "gone"], ans: 1, level: "A2" },
  { q: "I ___ TV when she called.", opts: ["watch", "watched", "was watching", "have watched"], ans: 2, level: "A2" },
  { q: "There aren't ___ eggs in the fridge.", opts: ["some", "any", "no", "much"], ans: 1, level: "A2" },
  { q: "She ___ play the piano when she was young.", opts: ["can", "could", "may", "will"], ans: 1, level: "A2" },
  { q: "I went to the store ___ I bought some bread.", opts: ["but", "and", "so", "because"], ans: 1, level: "A2" },
  { q: "My brother is ___ than me.", opts: ["tall", "taller", "tallest", "more tall"], ans: 1, level: "A2" },
  { q: "We ___ to Paris last summer.", opts: ["go", "goes", "went", "going"], ans: 2, level: "A2" },
  { q: "She has ___ finished her homework.", opts: ["yet", "already", "still", "since"], ans: 1, level: "A2" },
  { q: "I'm ___ at cooking than my sister.", opts: ["good", "better", "best", "more good"], ans: 1, level: "A2" },
  { q: "You ___ wear a uniform at this school.", opts: ["must", "can", "may", "would"], ans: 0, level: "A2" },
  { q: "He was born ___ 1995.", opts: ["at", "on", "in", "to"], ans: 2, level: "A2" },
  { q: "What ___ you do yesterday?", opts: ["do", "did", "does", "doing"], ans: 1, level: "A2" },

  // B1 (12 questions)
  { q: "If it rains, I ___ stay home.", opts: ["would", "will", "can", "may"], ans: 1, level: "B1" },
  { q: "She has lived here ___ 2015.", opts: ["for", "since", "from", "during"], ans: 1, level: "B1" },
  { q: "The book ___ by millions.", opts: ["has read", "has been read", "was reading", "is reading"], ans: 1, level: "B1" },
  { q: "If I were rich, I ___ travel the world.", opts: ["will", "would", "can", "shall"], ans: 1, level: "B1" },
  { q: "He told me that he ___ busy.", opts: ["is", "was", "will be", "has been"], ans: 1, level: "B1" },
  { q: "The woman ___ lives next door is a doctor.", opts: ["which", "who", "what", "whose"], ans: 1, level: "B1" },
  { q: "I've been waiting ___ two hours.", opts: ["since", "for", "during", "while"], ans: 1, level: "B1" },
  { q: "You should ___ harder for the exam.", opts: ["study", "to study", "studying", "studied"], ans: 0, level: "B1" },
  { q: "The film ___ when we arrived at the cinema.", opts: ["already started", "had already started", "has already started", "was already starting"], ans: 1, level: "B1" },
  { q: "She asked me where I ___.", opts: ["live", "lived", "am living", "do live"], ans: 1, level: "B1" },
  { q: "I ___ English for five years now.", opts: ["study", "studied", "have been studying", "am studying"], ans: 2, level: "B1" },
  { q: "He ___ to the gym three times a week.", opts: ["is going", "goes", "go", "going"], ans: 1, level: "B1" },

  // B2 (12 questions)
  { q: "I wish I ___ more time.", opts: ["have", "had", "would have", "has"], ans: 1, level: "B2" },
  { q: "Not only ___ he late, but he also forgot the files.", opts: ["was", "did", "is", "has"], ans: 0, level: "B2" },
  { q: "She denied ___ the window.", opts: ["to break", "breaking", "break", "broke"], ans: 1, level: "B2" },
  { q: "If I had studied harder, I ___ the exam.", opts: ["passed", "would pass", "would have passed", "had passed"], ans: 2, level: "B2" },
  { q: "He ___ have left already; his car is gone.", opts: ["can", "must", "should", "would"], ans: 1, level: "B2" },
  { q: "I'm not used to ___ up so early.", opts: ["get", "getting", "got", "gets"], ans: 1, level: "B2" },
  { q: "By this time next year, I ___ my degree.", opts: ["finish", "will finish", "will have finished", "am finishing"], ans: 2, level: "B2" },
  { q: "She suggested ___ a break.", opts: ["to take", "taking", "take", "took"], ans: 1, level: "B2" },
  { q: "The more you practice, the ___ you get.", opts: ["good", "better", "best", "well"], ans: 1, level: "B2" },
  { q: "He apologized ___ being late.", opts: ["about", "for", "of", "to"], ans: 1, level: "B2" },
  { q: "Hardly ___ I arrived when it started to rain.", opts: ["did", "had", "have", "was"], ans: 1, level: "B2" },
  { q: "She ___ rather stay at home than go out.", opts: ["had", "would", "will", "should"], ans: 1, level: "B2" },

  // C1 (12 questions)
  { q: "Seldom ___ such a talented musician.", opts: ["I have seen", "have I seen", "I saw", "did I see"], ans: 1, level: "C1" },
  { q: "Had I known, I ___ differently.", opts: ["would act", "would have acted", "acted", "had acted"], ans: 1, level: "C1" },
  { q: "The results are ___ with previous findings.", opts: ["consistent", "persistent", "resistant", "insistent"], ans: 0, level: "C1" },
  { q: "Under no circumstances ___ leave the building.", opts: ["you should", "should you", "you must", "must you"], ans: 1, level: "C1" },
  { q: "It is essential that he ___ on time.", opts: ["arrives", "arrive", "arrived", "arriving"], ans: 1, level: "C1" },
  { q: "The report, ___ was published yesterday, caused controversy.", opts: ["that", "which", "what", "it"], ans: 1, level: "C1" },
  { q: "So ___ was the damage that the building was demolished.", opts: ["extensive", "extending", "extent", "extension"], ans: 0, level: "C1" },
  { q: "Were it not ___ his help, we would have failed.", opts: ["about", "for", "with", "to"], ans: 1, level: "C1" },
  { q: "She couldn't help but ___ at the joke.", opts: ["laugh", "laughing", "to laugh", "laughed"], ans: 0, level: "C1" },
  { q: "No sooner ___ the door than the phone rang.", opts: ["I had opened", "had I opened", "I opened", "did I open"], ans: 1, level: "C1" },
  { q: "The proposal was turned ___ by the committee.", opts: ["off", "out", "down", "up"], ans: 2, level: "C1" },
  { q: "Little ___ he know what awaited him.", opts: ["does", "did", "had", "was"], ans: 1, level: "C1" },
];

const levels = [
  { code: "A1", label: "Beginner", labelKa: "დამწყები", color: "from-green-400 to-emerald-500", icon: "🌱" },
  { code: "A2", label: "Elementary", labelKa: "საწყისი", color: "from-sky-400 to-blue-500", icon: "📗" },
  { code: "B1", label: "Intermediate", labelKa: "საშუალო", color: "from-violet-400 to-purple-500", icon: "📘" },
  { code: "B2", label: "Upper-Intermediate", labelKa: "საშუალოზე მაღალი", color: "from-orange-400 to-amber-500", icon: "📙" },
  { code: "C1", label: "Advanced", labelKa: "მაღალი", color: "from-rose-400 to-pink-500", icon: "🏆" },
];
---

<Layout title="ინგლისურის დონის ტესტი — გაიგე შენი დონე | FluentGe" description="უფასო ინგლისურის დონის შეფასება 30 შეკითხვით. გაიგე A1-დან C1-მდე რა დონეზე ხარ და მიიღე პერსონალიზებული რეკომენდაციები.">
  <style>
    html.light .placement-card { background: white !important; border-color: #e5e7eb !important; }
    html.light .placement-card h2, html.light .placement-card h3 { color: #1a1a2e !important; }
    html.light .placement-card .text-\[\#6B6B65\] { color: #6b7280 !important; }
    html.light .pt-opt { background: white !important; border-color: #e5e7eb !important; }
    html.light .pt-opt:hover { border-color: rgba(56,189,248,0.5) !important; }
    html.light .pt-opt span:first-child { background: #f3f4f6 !important; color: #6b7280 !important; }
    html.light .pt-opt span:last-child { color: #1a1a2e !important; }
    html.light #pt-progress { background: linear-gradient(to right, #38bdf8, #34d399) !important; }
    html.light .w-full.h-3.bg-\[\#242426\] { background: #e5e7eb !important; }
    html.light #pt-next { background: #f3f4f6 !important; color: #1a1a2e !important; border-bottom-color: #d1d5db !important; }
    html.light #pt-retry { background: #f3f4f6 !important; color: #1a1a2e !important; border-bottom-color: #d1d5db !important; }
    html.light .text-\[\#A0A09A\] { color: #6b7280 !important; }
    html.light #pt-intro h1 { color: #1a1a2e !important; }
    html.light .placement-rec { background: #f9fafb !important; }
    html.light .placement-rec:hover { background: #f3f4f6 !important; }
    html.light .placement-rec span { color: #1a1a2e !important; }
    html.light .placement-rec .text-\[\#6B6B65\] { color: #9ca3af !important; }
    html.light #pt-result-label { color: #6b7280 !important; }
    html.light #pt-result-score { color: #9ca3af !important; }
    html.light .bg-\[\#2E2E30\][data-level-bar] { background: #e5e7eb !important; }
    html.light .placement-hero-overlay { background: linear-gradient(to bottom, rgba(240,242,245,0.7), #F0F2F5) !important; }
  </style>
  <!-- Hero Banner -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=1400&q=80" alt="" class="w-full h-full object-cover opacity-25"/>
      <div class="placement-hero-overlay absolute inset-0 bg-gradient-to-b from-[#1C1C1E]/70 to-[#1C1C1E]"></div>
    </div>
    <div class="relative pt-28 pb-8 text-center px-4">
      <div class="inline-block mb-4 bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-bold uppercase tracking-wider px-4 py-1.5 rounded-full">
        🎯 დონის შეფასება
      </div>
    </div>
  </section>

  <section class="flex items-center justify-center px-4 pb-20 pt-4">
    <div class="w-full max-w-2xl">

      <!-- Intro Screen -->
      <div id="pt-intro" class="text-center">
        <div class="text-6xl mb-6">🎯</div>
        <h1 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl font-bold mb-4">რა დონეზე ხარ?</h1>
        <p class="text-[#A0A09A] text-lg mb-2">უპასუხე 30 კითხვას და გაიგე შენი ინგლისურის დონე</p>
        <p class="text-[#6B6B65] text-sm mb-8">A1 → C1 | ადაპტური ტესტი | დაახლოებით 5 წუთი</p>
        <button id="pt-start" class="bg-sky-400 hover:bg-sky-500 text-white font-bold uppercase tracking-wide border-b-4 border-sky-500 active:border-b-0 rounded-xl px-10 py-4 text-lg transition-all">
          🚀 დაწყება
        </button>
      </div>

      <!-- Quiz Screen -->
      <div id="pt-quiz" class="hidden">
        <!-- Progress bar -->
        <div class="mb-8">
          <div class="flex items-center justify-between text-sm mb-2">
            <span class="text-[#6B6B65]">კითხვა <span id="pt-num">1</span>/30</span>
            <span id="pt-level-badge" class="text-xs font-bold px-2 py-0.5 rounded-full bg-green-500/20 text-green-400">B1</span>
          </div>
          <div class="w-full h-3 bg-[#242426] rounded-full overflow-hidden">
            <div id="pt-progress" class="h-full bg-gradient-to-r from-sky-400 to-emerald-400 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Question card -->
        <div class="placement-card bg-[#242426] border border-[#2E2E30] rounded-2xl p-6 sm:p-8 mb-6">
          <p class="text-xs text-[#6B6B65] uppercase tracking-wider mb-3">შეავსე ცარიელი ადგილი</p>
          <h2 id="pt-question" class="text-xl sm:text-2xl font-bold leading-relaxed"></h2>
        </div>

        <!-- Answer options -->
        <div id="pt-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6"></div>

        <!-- Next button -->
        <div id="pt-next-wrap" class="hidden text-center">
          <button id="pt-next" class="bg-[#2E2E30] hover:bg-[#3E3E40] text-[#F5F5F0] font-bold border-b-4 border-[#1C1C1E] active:border-b-0 rounded-xl px-8 py-3 transition-all">
            შემდეგი →
          </button>
        </div>
      </div>

      <!-- Result Screen -->
      <div id="pt-result" class="hidden text-center">
        <div id="pt-result-icon" class="text-7xl mb-4"></div>
        <div id="pt-result-badge" class="inline-block text-4xl font-black bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent mb-2"></div>
        <p id="pt-result-label" class="text-lg text-[#A0A09A] mb-1"></p>
        <p id="pt-result-score" class="text-sm text-[#6B6B65] mb-8"></p>

        <!-- Level bar -->
        <div class="flex items-center gap-1 justify-center mb-8">
          <span class="text-xs font-bold w-8 text-center text-green-400">A1</span>
          <span class="text-xs font-bold w-8 text-center text-sky-400">A2</span>
          <span class="text-xs font-bold w-8 text-center text-violet-400">B1</span>
          <span class="text-xs font-bold w-8 text-center text-orange-400">B2</span>
          <span class="text-xs font-bold w-8 text-center text-rose-400">C1</span>
        </div>
        <div class="flex items-center gap-0.5 justify-center mb-8">
          {[0,1,2,3,4].map(i => (
            <div class={`h-3 w-16 rounded-full ${i === 0 ? 'rounded-l-full' : ''} ${i === 4 ? 'rounded-r-full' : ''} bg-[#2E2E30]`} data-level-bar={i}></div>
          ))}
        </div>

        <div id="pt-next-step" class="mb-6"></div>

        <div class="placement-card bg-[#242426] border border-[#2E2E30] rounded-2xl p-6 text-left mb-6">
          <h3 class="font-bold text-lg mb-4">📋 რეკომენდაციები</h3>
          <div id="pt-recs" class="space-y-3"></div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a id="pt-start-learning" href="/flashcards/" class="bg-green-500 hover:bg-green-600 text-white font-bold uppercase tracking-wide border-b-4 border-green-600 active:border-b-0 rounded-xl px-8 py-3 transition-all">
            📚 სწავლის დაწყება
          </a>
          <button id="pt-retry" class="bg-[#2E2E30] hover:bg-[#3E3E40] text-[#F5F5F0] font-bold border-b-4 border-[#1C1C1E] active:border-b-0 rounded-xl px-8 py-3 transition-all">
            🔄 თავიდან
          </button>
        </div>
      </div>

    </div>
  </section>

  <script is:inline define:vars={{ questionBank, levels }}>
    (function() {
      const TOTAL_QUESTIONS = 30;
      const LEVEL_ORDER = ["A1", "A2", "B1", "B2", "C1"];
      const $ = s => document.querySelector(s);
      const show = el => el.classList.remove('hidden');
      const hide = el => el.classList.add('hidden');

      // Adaptive state
      let questionNum = 0;
      let answered = false;
      let currentLevel = 2; // index into LEVEL_ORDER, start at B1
      let currentQuestion = null;
      let usedIndices = new Set();
      let levelStats = { A1: { correct: 0, total: 0 }, A2: { correct: 0, total: 0 }, B1: { correct: 0, total: 0 }, B2: { correct: 0, total: 0 }, C1: { correct: 0, total: 0 } };

      // Group questions by level
      const byLevel = {};
      LEVEL_ORDER.forEach(l => byLevel[l] = []);
      questionBank.forEach((q, i) => byLevel[q.level].push(i));

      function pickQuestion() {
        const lvl = LEVEL_ORDER[currentLevel];
        // Try current level first, then adjacent levels
        const tryOrder = [0, -1, 1, -2, 2];
        for (const offset of tryOrder) {
          const li = currentLevel + offset;
          if (li < 0 || li >= LEVEL_ORDER.length) continue;
          const pool = byLevel[LEVEL_ORDER[li]].filter(i => !usedIndices.has(i));
          if (pool.length > 0) {
            const idx = pool[Math.floor(Math.random() * pool.length)];
            usedIndices.add(idx);
            return questionBank[idx];
          }
        }
        // Fallback: any unused question
        for (let i = 0; i < questionBank.length; i++) {
          if (!usedIndices.has(i)) { usedIndices.add(i); return questionBank[i]; }
        }
        return null;
      }

      function getEstimatedLevel() {
        // Highest level with 60%+ correct (min 2 attempts)
        let best = 0;
        for (let i = LEVEL_ORDER.length - 1; i >= 0; i--) {
          const s = levelStats[LEVEL_ORDER[i]];
          if (s.total >= 2 && s.correct / s.total >= 0.6) { best = i; break; }
        }
        // If no level has 2+ attempts with 60%, use currentLevel heuristic
        let found = false;
        for (let i = 0; i < LEVEL_ORDER.length; i++) {
          if (levelStats[LEVEL_ORDER[i]].total >= 2 && levelStats[LEVEL_ORDER[i]].correct / levelStats[LEVEL_ORDER[i]].total >= 0.6) { found = true; break; }
        }
        if (!found) return currentLevel;
        return best;
      }

      const badgeColors = { A1: 'bg-green-500/20 text-green-400', A2: 'bg-sky-500/20 text-sky-400', B1: 'bg-violet-500/20 text-violet-400', B2: 'bg-orange-500/20 text-orange-400', C1: 'bg-rose-500/20 text-rose-400' };

      function renderQ() {
        currentQuestion = pickQuestion();
        if (!currentQuestion) { showResult(); return; }
        questionNum++;
        $('#pt-num').textContent = questionNum;
        $('#pt-progress').style.width = ((questionNum - 1) / TOTAL_QUESTIONS * 100) + '%';
        $('#pt-question').innerHTML = currentQuestion.q.replace('___', '<span class="inline-block border-b-2 border-sky-400 px-2 mx-1 min-w-[60px]">___</span>');

        const estLvl = LEVEL_ORDER[getEstimatedLevel()];
        $('#pt-level-badge').textContent = estLvl;
        $('#pt-level-badge').className = 'text-xs font-bold px-2 py-0.5 rounded-full ' + (badgeColors[estLvl] || '');

        const optsDiv = $('#pt-options');
        optsDiv.innerHTML = '';
        const letters = ['A', 'B', 'C', 'D'];
        currentQuestion.opts.forEach((opt, i) => {
          const btn = document.createElement('button');
          btn.className = 'pt-opt flex items-center gap-3 bg-[#242426] border-2 border-[#2E2E30] hover:border-sky-400/50 rounded-xl px-5 py-4 text-left transition-all font-medium min-h-[52px]';
          btn.innerHTML = `<span class="w-8 h-8 rounded-lg bg-[#2E2E30] flex items-center justify-center text-sm font-bold text-[#6B6B65]">${letters[i]}</span><span>${opt}</span>`;
          btn.onclick = () => selectAnswer(i);
          optsDiv.appendChild(btn);
        });
        answered = false;
        hide($('#pt-next-wrap'));
      }

      function selectAnswer(i) {
        if (answered) return;
        answered = true;
        const q = currentQuestion;
        const correct = i === q.ans;

        // Update stats
        levelStats[q.level].total++;
        if (correct) levelStats[q.level].correct++;

        // Adapt: move level up/down
        if (correct) { currentLevel = Math.min(currentLevel + 1, LEVEL_ORDER.length - 1); }
        else { currentLevel = Math.max(currentLevel - 1, 0); }

        // Visual feedback
        const btns = document.querySelectorAll('.pt-opt');
        btns.forEach((btn, j) => {
          btn.classList.remove('hover:border-sky-400/50');
          if (j === q.ans) {
            btn.classList.add('border-green-400', 'bg-green-500/10');
            btn.querySelector('span:first-child').classList.add('bg-green-500', 'text-white');
            btn.querySelector('span:first-child').classList.remove('bg-[#2E2E30]', 'text-[#6B6B65]');
          }
          if (j === i && !correct) {
            btn.classList.add('border-rose-400', 'bg-rose-500/10');
            btn.querySelector('span:first-child').classList.add('bg-rose-500', 'text-white');
            btn.querySelector('span:first-child').classList.remove('bg-[#2E2E30]', 'text-[#6B6B65]');
          }
        });

        // Update badge in real-time
        const estLvl = LEVEL_ORDER[getEstimatedLevel()];
        $('#pt-level-badge').textContent = estLvl;
        $('#pt-level-badge').className = 'text-xs font-bold px-2 py-0.5 rounded-full ' + (badgeColors[estLvl] || '');

        show($('#pt-next-wrap'));
      }

      function showResult() {
        hide($('#pt-quiz'));
        show($('#pt-result'));

        // Determine final level: highest level with 60%+ (need at least 1 attempt)
        let lvlIdx = 0;
        for (let i = LEVEL_ORDER.length - 1; i >= 0; i--) {
          const s = levelStats[LEVEL_ORDER[i]];
          if (s.total >= 1 && s.correct / s.total >= 0.6) { lvlIdx = i; break; }
        }
        const lvl = levels[lvlIdx];

        // Count total correct
        let totalCorrect = 0;
        LEVEL_ORDER.forEach(l => totalCorrect += levelStats[l].correct);

        $('#pt-result-icon').textContent = lvl.icon;
        $('#pt-result-badge').textContent = lvl.code;
        $('#pt-result-badge').className = `inline-block text-4xl font-black bg-gradient-to-r ${lvl.color} bg-clip-text text-transparent mb-2`;
        $('#pt-result-label').textContent = `${lvl.label} — ${lvl.labelKa}`;
        $('#pt-result-score').textContent = `${totalCorrect}/${questionNum} სწორი პასუხი`;

        // Color level bars
        document.querySelectorAll('[data-level-bar]').forEach(bar => {
          const idx = parseInt(bar.dataset.levelBar);
          if (idx <= lvlIdx) {
            const gradients = ['bg-green-400', 'bg-sky-400', 'bg-violet-400', 'bg-orange-400', 'bg-rose-400'];
            bar.classList.remove('bg-[#2E2E30]');
            bar.classList.add(gradients[idx]);
          }
        });

        // Recommendations
        const recs = {
          A1: [
            { icon: '📚', text: 'დაიწყე Top 2000 სიტყვების სწავლა', link: '/flashcards/' },
            { icon: '📖', text: 'A1 გრამატიკის გაკვეთილები', link: '/grammar/' },
            { icon: '🎧', text: 'აეროპორტის პოდკასტი (მარტივი)', link: '/podcast/' },
          ],
          A2: [
            { icon: '📚', text: 'აირჩიე თემატური დეკები (ემოციები, საკვები...)', link: '/flashcards/' },
            { icon: '📖', text: 'A2 გრამატიკა — წარსული დრო', link: '/grammar/' },
            { icon: '🎮', text: 'სიტყვების თამაშები', link: '/games/' },
          ],
          B1: [
            { icon: '📚', text: 'Intermediate დეკები (ბიზნესი, მეცნიერება)', link: '/flashcards/' },
            { icon: '📖', text: 'B1 გრამატიკა — პირობითი წინადადებები', link: '/grammar/' },
            { icon: '🎧', text: 'პოდკასტები — დიალოგები', link: '/podcast/' },
          ],
          B2: [
            { icon: '📚', text: 'Advanced ლექსიკა', link: '/flashcards/' },
            { icon: '📖', text: 'B2 გრამატიკა — ვნებითი გვარი', link: '/grammar/' },
            { icon: '💬', text: 'ფრაზების პრაქტიკა', link: '/phrases/' },
          ],
          C1: [
            { icon: '📚', text: 'C1 აკადემიური ლექსიკა', link: '/flashcards/' },
            { icon: '📖', text: 'C1 გრამატიკა — ინვერსია', link: '/grammar/' },
            { icon: '🏆', text: 'ყველა თამაში გაიარე!', link: '/games/' },
          ],
        };

        const recsDiv = $('#pt-recs');
        recsDiv.innerHTML = '';
        (recs[lvl.code] || recs.A1).forEach(r => {
          recsDiv.innerHTML += `<a href="${r.link}" class="placement-rec flex items-center gap-3 bg-[#1C1C1E] rounded-xl px-4 py-3 hover:bg-[#2E2E30] transition-colors">
            <span class="text-2xl">${r.icon}</span>
            <span class="text-sm font-medium">${r.text}</span>
            <span class="ml-auto text-[#6B6B65]">→</span>
          </a>`;
        });

        localStorage.setItem('fluentge-placement-level', lvl.code);
        localStorage.setItem('fluentge-placement-score', totalCorrect);

        const nextSteps = {
          A1: { emoji: '🌱', title: 'დაიწყე საბაზისო სიტყვებით', desc: 'მისალმებები, რიცხვები, ფერები — ყოველდღიური სიტყვები რომლებიც პირველ რიგში გჭირდება', btnText: '🚀 დაიწყე A1 დეკებით', link: '/flashcards/#study/greetings-farewells/classic' },
          A2: { emoji: '📗', title: 'გააძლიერე საწყისი ცოდნა', desc: 'ყოველდღიური ფრაზები, საკვები, მოგზაურობა — სიტყვები რომლებიც საუბარში დაგჭირდება', btnText: '🚀 გააგრძელე A2 დეკებით', link: '/flashcards/' },
          B1: { emoji: '📘', title: 'გააფართოვე ლექსიკა', desc: 'ბიზნესი, ტექნოლოგიები, ჯანმრთელობა — პროფესიული ლექსიკა', btnText: '🚀 გადადი B1 დეკებზე', link: '/flashcards/' },
          B2: { emoji: '📙', title: 'დახვეწე ენა', desc: 'იდიომები, ფრაზული ზმნები, აკადემიური ლექსიკა — თავისუფალი მეტყველება', btnText: '🚀 B2 ლექსიკა', link: '/flashcards/' },
          C1: { emoji: '🏆', title: 'შენ უკვე მაღალ დონეზე ხარ!', desc: 'გამოიყენე თამაშები, პოდკასტები და გრამატიკა ცოდნის შესანარჩუნებლად', btnText: '🎮 თამაშები და პოდკასტი', link: '/games/' },
        };
        const ns = nextSteps[lvl.code] || nextSteps.A1;
        $('#pt-next-step').innerHTML = `
          <div class="bg-gradient-to-br ${lvl.color} rounded-2xl p-6 text-center text-white mb-4 relative overflow-hidden">
            <div class="absolute inset-0 bg-black/20"></div>
            <div class="relative">
              <div class="text-4xl mb-3">${ns.emoji}</div>
              <h3 class="text-xl font-bold mb-2">${ns.title}</h3>
              <p class="text-white/80 text-sm mb-5">${ns.desc}</p>
              <a href="${ns.link}" class="inline-block bg-white text-gray-900 font-bold px-8 py-3.5 rounded-xl text-base border-b-4 border-gray-300 hover:bg-gray-100 active:border-b-0 active:mt-1 transition-all">
                ${ns.btnText}
              </a>
            </div>
          </div>
          <p class="text-center text-xs text-[#6B6B65]">ან აირჩიე ქვემოთ მოცემული ვარიანტებიდან</p>
        `;

        const startBtn = $('#pt-start-learning');
        if (startBtn) startBtn.href = ns.link;
        $('#pt-progress').style.width = '100%';
      }

      // Events
      $('#pt-start').onclick = () => { hide($('#pt-intro')); show($('#pt-quiz')); renderQ(); };
      $('#pt-next').onclick = () => {
        if (questionNum >= TOTAL_QUESTIONS) showResult();
        else renderQ();
      };
      $('#pt-retry').onclick = () => {
        questionNum = 0; currentLevel = 2; usedIndices.clear(); answered = false; currentQuestion = null;
        LEVEL_ORDER.forEach(l => { levelStats[l] = { correct: 0, total: 0 }; });
        document.querySelectorAll('[data-level-bar]').forEach(bar => {
          bar.classList.remove('bg-green-400', 'bg-sky-400', 'bg-violet-400', 'bg-orange-400', 'bg-rose-400');
          bar.classList.add('bg-[#2E2E30]');
        });
        hide($('#pt-result')); show($('#pt-intro'));
      };
    })();
  </script>
</Layout>
