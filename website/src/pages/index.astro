    .light .ret-hero-title { color: #1a1a2e !important; text-shadow: none !important; }
    .light .ret-hero-sub { color: #1f2937 !important; text-shadow: none !important; opacity: 1 !important; }
    /* Testimonial section container light mode — remove border/shadow */
    .light #testimonial-carousel { border: none !important; box-shadow: none !important; }
    .light .testimonial-section { border: none !important; box-shadow: none !important; background: transparent !important; }
    /* Newsletter light mode */
  </style>

  <!-- Animated Social Proof Counter Bar -->
  <section class="px-4 py-6 max-w-4xl mx-auto">
    <div class="counter-bar bg-gradient-to-r from-sky-500/5 via-green-500/5 to-amber-500/5 border border-white/5 rounded-2xl px-6 py-5">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white counter" data-target="5250">0</div>
          <div class="text-[10px] sm:text-xs text-[#6B6B65] font-medium mt-1 uppercase tracking-wider">სიტყვა</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white counter" data-target="65">0</div>
          <div class="text-[10px] sm:text-xs text-[#6B6B65] font-medium mt-1 uppercase tracking-wider">გრამატიკა</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white counter" data-target="35">0</div>
          <div class="text-[10px] sm:text-xs text-[#6B6B65] font-medium mt-1 uppercase tracking-wider">პოდკასტი</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-white counter" data-target="12">0</div>
          <div class="text-[10px] sm:text-xs text-[#6B6B65] font-medium mt-1 uppercase tracking-wider">სასწავლო რეჟიმი</div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Animated counter
    (function() {
      var counters = document.querySelectorAll('.counter');
      var animated = false;
      function animateCounters() {
        if (animated) return;
        animated = true;
        counters.forEach(function(el) {
          var target = parseInt(el.getAttribute('data-target'), 10);
          var duration = 1500;
          var start = performance.now();
          function tick(now) {
            var elapsed = now - start;
            var progress = Math.min(elapsed / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            var current = Math.floor(eased * target);
            el.textContent = current >= 1000 ? current.toLocaleString() + '+' : current.toString() + (target >= 100 ? '+' : '');
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { animateCounters(); observer.disconnect(); }
        });
      }, { threshold: 0.3 });
      if (counters.length > 0) observer.observe(counters[0].parentElement.parentElement);
    })();
  </script>

  <!-- Onboarding CTA — Direct to Top 2000 -->
