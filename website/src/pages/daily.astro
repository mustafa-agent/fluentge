      { type: "გრამატიკა", q: "Unless you ___, you won't improve.", opts: ["practice", "practiced", "will practice", "practicing"], ans: 0 },
      { type: "გრამატიკა", q: "I wish I ___ more time.", opts: ["have", "had", "will have", "am having"], ans: 1 },
      { type: "გრამატიკა", q: "If only he ___ the truth earlier.", opts: ["tells", "told", "had told", "would tell"], ans: 2 },
      { type: "გრამატიკა", q: "Were I you, I ___ accept the offer.", opts: ["will", "would", "can", "shall"], ans: 1 },
      { type: "გრამატიკა", q: "Had I known, I ___ come.", opts: ["will have", "would have", "had", "was"], ans: 1 },

      // ===== GRAMMAR - Passive Voice (B1-B2) =====
      { type: "გრამატიკა", q: "The cake ___ by my mother.", opts: ["baked", "was baked", "baking", "has baking"], ans: 1 },
      { type: "გრამატიკა", q: "English ___ in many countries.", opts: ["speaks", "is spoken", "spoke", "speaking"], ans: 1 },
      { type: "გრამატიკა", q: "The letter ___ yesterday.", opts: ["sent", "was sent", "is sent", "sends"], ans: 1 },
      { type: "გრამატიკა", q: "A new hospital ___ next year.", opts: ["will build", "will be built", "builds", "is building"], ans: 1 },
      { type: "გრამატიკა", q: "The window ___ by the storm.", opts: ["broke", "was broken", "breaks", "is breaking"], ans: 1 },
      { type: "გრამატიკა", q: "These shoes ___ in Italy.", opts: ["make", "are made", "made", "making"], ans: 1 },
      { type: "გრამატიკა", q: "The project ___ already ___.", opts: ["has/completed", "has/been completed", "is/completing", "was/complete"], ans: 1 },

      // ===== GRAMMAR - Modals (A2-B2) =====
      { type: "გრამატიკა", q: "You ___ smoke here. It's forbidden.", opts: ["mustn't", "don't have to", "shouldn't", "can't to"], ans: 0 },
      { type: "გრამატიკა", q: "You ___ wear a uniform. It's optional.", opts: ["mustn't", "don't have to", "can't", "shouldn't"], ans: 1 },
      { type: "გრამატიკა", q: "She ___ be at home. Her car is outside.", opts: ["must", "can", "should", "would"], ans: 0 },
      { type: "გრამატიკა", q: "You ___ see a doctor about that cough.", opts: ["must", "should", "will", "can"], ans: 1 },
      { type: "გრამატიკა", q: "He ___ swim when he was five.", opts: ["can", "could", "may", "must"], ans: 1 },

      // ===== GRAMMAR - Relative Clauses (B1-B2) =====
      { type: "გრამატიკა", q: "The woman ___ lives next door is a teacher.", opts: ["which", "who", "whom", "whose"], ans: 1 },
      { type: "გრამატიკა", q: "The book ___ I read was excellent.", opts: ["who", "which", "whose", "whom"], ans: 1 },
