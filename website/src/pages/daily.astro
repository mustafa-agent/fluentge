      { type: "გრამატიკა", q: "He apologized ___ being late.", opts: ["about", "of", "for", "to"], ans: 2 },

      // ===== GRAMMAR - Articles (A1-B2) =====
      { type: "გრამატიკა", q: "___ sun rises in the east.", opts: ["A", "An", "The", "-"], ans: 2 },
      { type: "გრამატიკა", q: "She is ___ honest person.", opts: ["a", "an", "the", "-"], ans: 1 },
      { type: "გრამატიკა", q: "I want to be ___ doctor.", opts: ["a", "an", "the", "-"], ans: 0 },
      { type: "გრამატიკა", q: "___ water is essential for life.", opts: ["A", "An", "The", "-"], ans: 3 },
      { type: "გრამატიკა", q: "He plays ___ guitar very well.", opts: ["a", "an", "the", "-"], ans: 2 },

      // ===== GRAMMAR - Conditionals (B1-C1) =====
      { type: "გრამატიკა", q: "If it rains, I ___ stay home.", opts: ["would", "will", "can", "might have"], ans: 1 },
      { type: "გრამატიკა", q: "If I had studied, I ___ passed.", opts: ["will have", "would have", "had", "have"], ans: 1 },
