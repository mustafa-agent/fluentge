      // ===== VOCABULARY (A1-B2) =====
      { type: "ლექსიკა", q: "რას ნიშნავს 'accomplish'?", opts: ["მიტოვება", "მიღწევა", "შეცდომა", "გადაწყვეტილება"], ans: 1 },
      { type: "ლექსიკა", q: "რას ნიშნავს 'resilient'?", opts: ["ლამაზი", "სწრაფი", "გამძლე", "მოწყენილი"], ans: 2 },
