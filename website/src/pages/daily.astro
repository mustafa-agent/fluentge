---
import Layout from '../layouts/Layout.astro';
---

<Layout title="დღის გამოწვევა — FluentGe" description="ყოველდღიური ინგლისურის ტესტი — 10 შეკითხვა. შეამოწმე შენი ცოდნა და აკონტროლე პროგრესი!">
  <section class="max-w-2xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h1 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl mb-3">🏆 დღის გამოწვევა</h1>
      <p class="text-[#6B6B65] text-sm" id="date-display"></p>
      <div class="flex justify-center gap-4 mt-4">
        <div class="daily-stat-card bg-[#242426] border border-[#2E2E30] rounded-xl px-4 py-2 text-center">
          <p class="text-xs text-[#6B6B65]">სერია 🔥</p>
          <p class="text-xl font-bold" id="streak">0</p>
        </div>
        <div class="daily-stat-card bg-[#242426] border border-[#2E2E30] rounded-xl px-4 py-2 text-center">
          <p class="text-xs text-[#6B6B65]">საუკეთესო</p>
          <p class="text-xl font-bold" id="best-score">0/10</p>
        </div>
      </div>
    </div>

    <!-- Quiz Container -->
    <div id="quiz-container">
      <div id="progress-bar" class="w-full bg-[#2E2E30] rounded-full h-2 mb-6">
        <div id="progress-fill" class="bg-green-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <div id="question-counter" class="text-xs text-[#6B6B65] mb-4 text-center"></div>
      <div id="question-card" class="bg-[#242426] border border-[#2E2E30] rounded-2xl p-6 mb-4">
        <p id="question-type" class="text-xs text-[#6B6B65] uppercase tracking-wider mb-2"></p>
        <h2 id="question-text" class="text-xl font-bold mb-6 text-center"></h2>
        <div id="options" class="space-y-3"></div>
      </div>
      <div id="feedback" class="hidden bg-[#242426] border rounded-2xl p-4 mb-4 text-center"></div>
    </div>

    <!-- Results -->
    <div id="results" class="hidden text-center">
      <div class="bg-[#242426] border border-[#2E2E30] rounded-2xl p-8">
        <p class="text-5xl mb-4" id="result-emoji"></p>
        <h2 class="font-['Playfair_Display',serif] text-2xl mb-2">შედეგი</h2>
        <p class="text-4xl font-bold mb-2" id="score-display"></p>
        <p class="text-[#6B6B65] text-sm mb-6" id="result-message"></p>
        <div class="flex gap-3 justify-center">
          <button onclick="location.reload()" class="bg-white text-[#1C1C1E] font-semibold px-6 py-3 rounded-xl hover:bg-[#E8E8E0] transition-colors">ხვალ ისევ ცადე</button>
          <a href="/flashcards/" class="bg-white/10 border border-white/10 font-semibold px-6 py-3 rounded-xl hover:bg-white/20 transition-colors">ივარჯიშე</a>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    /* Daily Challenge — Light Mode */
    html.light .daily-stat-card {
      background: #fff !important;
      border-color: #e5e7eb !important;
    }
    html.light #question-card {
      background: #fff !important;
      border-color: #e5e7eb !important;
    }
    html.light #options button {
      background: #fff !important;
      border-color: #e5e7eb !important;
      color: #1a1a2e !important;
    }
    html.light #options button:hover {
      border-color: #6366f1 !important;
      background: #f9fafb !important;
    }
    html.light #options button.border-green-500 {
      border-color: #22c55e !important;
      background: rgba(34,197,94,0.08) !important;
    }
    html.light #options button.border-red-500 {
      border-color: #ef4444 !important;
      background: rgba(239,68,68,0.08) !important;
    }
    html.light #feedback.text-green-400 {
      color: #16a34a !important;
    }
    html.light #feedback.text-red-400 {
      color: #dc2626 !important;
    }
    html.light #results .bg-\[\#242426\] {
      background: #fff !important;
      border-color: #e5e7eb !important;
    }
    html.light #progress-bar {
      background: #e5e7eb !important;
    }
  </style>

  <script>
    // Seeded random for daily consistency
    function seededRandom(seed) {
      let x = Math.sin(seed) * 10000;
      return x - Math.floor(x);
    }

    const today = new Date();
    const dateStr = today.toLocaleDateString('ka-GE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    document.getElementById('date-display').textContent = dateStr;
    const daySeed = Math.floor(today.getTime() / 86400000);

    // Question bank — mix of grammar, vocab, phrases
    const allQuestions = [
      // ===== GRAMMAR - Verb Tenses (A1-B2) =====
      { type: "გრამატიკა", q: "She ___ to school every day.", opts: ["go", "goes", "going", "gone"], ans: 1 },
      { type: "გრამატიკა", q: "I have ___ finished my homework.", opts: ["yet", "already", "still", "since"], ans: 1 },
      { type: "გრამატიკა", q: "If I ___ rich, I would travel.", opts: ["am", "was", "were", "be"], ans: 2 },
      { type: "გრამატიკა", q: "They ___ here since 2020.", opts: ["live", "lived", "have lived", "are living"], ans: 2 },
      { type: "გრამატიკა", q: "The book ___ by millions.", opts: ["read", "is read", "reads", "reading"], ans: 1 },
      { type: "გრამატიკა", q: "I wish I ___ speak French.", opts: ["can", "could", "would", "will"], ans: 1 },
      { type: "გრამატიკა", q: "___ you ever been to London?", opts: ["Did", "Have", "Are", "Do"], ans: 1 },
      { type: "გრამატიკა", q: "He's the man ___ car was stolen.", opts: ["who", "which", "whose", "whom"], ans: 2 },
      { type: "გრამატიკა", q: "She asked me where I ___.", opts: ["live", "lived", "living", "lives"], ans: 1 },
      { type: "გრამატიკა", q: "I ___ TV when he called.", opts: ["watch", "watched", "was watching", "have watched"], ans: 2 },
      { type: "გრამატიკა", q: "We need ___ more water.", opts: ["buy", "to buy", "buying", "bought"], ans: 1 },
      { type: "გრამატიკა", q: "This is ___ interesting book.", opts: ["a", "an", "the", "-"], ans: 1 },
      { type: "გრამატიკა", q: "She runs ___ than her brother.", opts: ["fast", "faster", "fastest", "more fast"], ans: 1 },
      { type: "გრამატიკა", q: "I ___ go to the doctor.", opts: ["must", "must to", "have must", "musting"], ans: 0 },
      { type: "გრამატიკა", q: "There aren't ___ eggs left.", opts: ["some", "any", "no", "much"], ans: 1 },
      { type: "გრამატიკა", q: "He ___ dinner right now.", opts: ["cooks", "is cooking", "cooked", "has cooked"], ans: 1 },
      { type: "გრამატიკა", q: "We ___ to Paris last summer.", opts: ["go", "goes", "went", "have gone"], ans: 2 },
      { type: "გრამატიკა", q: "She ___ her keys yesterday.", opts: ["lose", "lost", "has lost", "losing"], ans: 1 },
      { type: "გრამატიკა", q: "I ___ this movie before.", opts: ["see", "saw", "have seen", "am seeing"], ans: 2 },
      { type: "გრამატიკა", q: "They ___ for two hours when I arrived.", opts: ["waited", "have waited", "had been waiting", "are waiting"], ans: 2 },
      { type: "გრამატიკა", q: "By next year, I ___ graduated.", opts: ["will", "will have", "am going to", "would"], ans: 1 },
      { type: "გრამატიკა", q: "She ___ English since childhood.", opts: ["studies", "studied", "has studied", "is studying"], ans: 2 },
      { type: "გრამატიკა", q: "The train ___ at 9 AM tomorrow.", opts: ["leaves", "will leave", "is leaving", "left"], ans: 0 },
      { type: "გრამატიკა", q: "I ___ to call you, but I forgot.", opts: ["was going", "am going", "will go", "have gone"], ans: 0 },
      { type: "გრამატიკა", q: "He ___ when the phone rang.", opts: ["slept", "was sleeping", "has slept", "sleeps"], ans: 1 },

      // ===== GRAMMAR - Prepositions (A1-B1) =====
      { type: "გრამატიკა", q: "I live ___ Tbilisi.", opts: ["at", "in", "on", "to"], ans: 1 },
      { type: "გრამატიკა", q: "The meeting is ___ Monday.", opts: ["in", "at", "on", "by"], ans: 2 },
      { type: "გრამატიკა", q: "She arrived ___ 3 o'clock.", opts: ["in", "on", "at", "by"], ans: 2 },
      { type: "გრამატიკა", q: "The cat is ___ the table.", opts: ["under", "in", "at", "to"], ans: 0 },
      { type: "გრამატიკა", q: "I'm interested ___ history.", opts: ["at", "on", "in", "for"], ans: 2 },
      { type: "გრამატიკა", q: "He depends ___ his parents.", opts: ["in", "on", "at", "for"], ans: 1 },
      { type: "გრამატიკა", q: "She's afraid ___ spiders.", opts: ["from", "at", "with", "of"], ans: 3 },
      { type: "გრამატიკა", q: "We arrived ___ the airport early.", opts: ["in", "at", "on", "to"], ans: 1 },
