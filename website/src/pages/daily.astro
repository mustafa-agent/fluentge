      { type: "გრამატიკა", q: "The hotel ___ we stayed was lovely.", opts: ["which", "where", "that", "when"], ans: 1 },

      // ===== GRAMMAR - Reported Speech (B1-B2) =====
      { type: "გრამატიკა", q: "He said he ___ tired.", opts: ["is", "was", "will be", "has been"], ans: 1 },
      { type: "გრამატიკა", q: "She told me she ___ call later.", opts: ["will", "would", "can", "shall"], ans: 1 },
      { type: "გრამატიკა", q: "They asked if I ___ help.", opts: ["can", "could", "will", "shall"], ans: 1 },
      { type: "გრამატიკა", q: "He asked me where I ___.", opts: ["work", "worked", "working", "works"], ans: 1 },

      // ===== GRAMMAR - Miscellaneous (A2-C1) =====
      { type: "გრამატიკა", q: "Neither Tom ___ Jerry came.", opts: ["or", "nor", "and", "but"], ans: 1 },
      { type: "გრამატიკა", q: "Not only is she smart, ___ she is kind.", opts: ["and", "but", "or", "so"], ans: 1 },
      { type: "გრამატიკა", q: "The more you practice, the ___ you get.", opts: ["good", "best", "better", "well"], ans: 2 },
      { type: "გრამატიკა", q: "I'd rather ___ at home tonight.", opts: ["stay", "to stay", "staying", "stayed"], ans: 0 },
      { type: "გრამატიკა", q: "He suggested that she ___ a doctor.", opts: ["sees", "see", "saw", "seeing"], ans: 1 },
      { type: "გრამატიკა", q: "It's time we ___ home.", opts: ["go", "went", "going", "gone"], ans: 1 },
      { type: "გრამატიკა", q: "She's used to ___ early.", opts: ["wake", "waking", "woke", "waken"], ans: 1 },
      { type: "გრამატიკა", q: "I used to ___ soccer as a child.", opts: ["play", "playing", "played", "plays"], ans: 0 },
      { type: "გრამატიკა", q: "___ of the students passed the exam.", opts: ["All", "Every", "Each", "Both"], ans: 0 },
      { type: "გრამატიკა", q: "He hardly ___ comes to class.", opts: ["never", "ever", "always", "-"], ans: 1 },
      { type: "გრამატიკა", q: "So do I means ___.", opts: ["I don't", "me too", "I disagree", "maybe"], ans: 1 },
      { type: "გრამატიკა", q: "She ___ have left already.", opts: ["can", "might", "shall", "will"], ans: 1 },
      { type: "გრამატიკა", q: "It ___ that he was wrong.", opts: ["turned on", "turned out", "turned up", "turned in"], ans: 1 },
      { type: "გრამატიკა", q: "I look forward ___ you.", opts: ["to see", "to seeing", "seeing", "see"], ans: 1 },
      { type: "გრამატიკა", q: "She made me ___ the dishes.", opts: ["wash", "to wash", "washing", "washed"], ans: 0 },
      { type: "გრამატიკა", q: "He let her ___ early.", opts: ["leave", "to leave", "leaving", "left"], ans: 0 },
