    // Pick 10 questions seeded by day
    function pickDaily(seed, arr, count) {
      const shuffled = [...arr];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(seededRandom(seed + i) * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled.slice(0, count);
    }

    const questions = pickDaily(daySeed, allQuestions, 10);
    let current = 0;
    let score = 0;
    let answered = false;

    // Load stats
    const stats = JSON.parse(localStorage.getItem('fluentge-daily') || '{}');
    const todayKey = today.toISOString().split('T')[0];

    // Check if already completed today
    if (stats.lastDate === todayKey && stats.todayScore !== undefined) {
      showResults(stats.todayScore, false);
    } else {
      // Update streak display
      document.getElementById('streak').textContent = stats.streak || 0;
      document.getElementById('best-score').textContent = (stats.bestScore || 0) + '/10';
      showQuestion();
    }

    function showQuestion() {
      if (current >= questions.length) {
        finishQuiz();
        return;
      }
      answered = false;
      const q = questions[current];
      document.getElementById('question-counter').textContent = `${current + 1} / ${questions.length}`;
      document.getElementById('progress-fill').style.width = `${(current / questions.length) * 100}%`;
      document.getElementById('question-type').textContent = q.type;
      document.getElementById('question-text').textContent = q.q;
      document.getElementById('feedback').classList.add('hidden');

      const optsDiv = document.getElementById('options');
      optsDiv.innerHTML = '';
      q.opts.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'w-full text-left px-5 py-3.5 rounded-xl bg-[#1C1C1E] border border-[#2E2E30] hover:border-[#505050] transition-all text-sm font-medium min-h-[48px]';
        btn.textContent = opt;
        btn.onclick = () => selectAnswer(i);
        optsDiv.appendChild(btn);
      });
    }

    function selectAnswer(idx) {
      if (answered) return;
      answered = true;
      const q = questions[current];
      const btns = document.getElementById('options').children;
      const fb = document.getElementById('feedback');

      if (idx === q.ans) {
        score++;
        btns[idx].classList.add('border-green-500', 'bg-green-500/10');
        fb.textContent = '✅ სწორია!';
        fb.className = 'bg-green-500/10 border border-green-500/30 rounded-2xl p-4 mb-4 text-center text-green-400';
      } else {
        btns[idx].classList.add('border-red-500', 'bg-red-500/10');
        btns[q.ans].classList.add('border-green-500', 'bg-green-500/10');
        fb.textContent = '❌ სწორი პასუხი: ' + q.opts[q.ans];
        fb.className = 'bg-red-500/10 border border-red-500/30 rounded-2xl p-4 mb-4 text-center text-red-400';
      }
      fb.classList.remove('hidden');

      setTimeout(() => {
        current++;
        showQuestion();
      }, 1500);
    }

    function finishQuiz() {
      // Update stats
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);
      const yesterdayKey = yesterday.toISOString().split('T')[0];

      let streak = stats.streak || 0;
      if (stats.lastDate === yesterdayKey) {
        streak++;
      } else if (stats.lastDate !== todayKey) {
        streak = 1;
      }

      const bestScore = Math.max(stats.bestScore || 0, score);
      const newStats = { lastDate: todayKey, todayScore: score, streak, bestScore };
      localStorage.setItem('fluentge-daily', JSON.stringify(newStats));

      showResults(score, true);
    }

    function showResults(finalScore, isNew) {
      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('results').classList.remove('hidden');
      document.getElementById('score-display').textContent = `${finalScore}/10`;

      const stats = JSON.parse(localStorage.getItem('fluentge-daily') || '{}');
      document.getElementById('streak').textContent = stats.streak || 0;
      document.getElementById('best-score').textContent = (stats.bestScore || 0) + '/10';

      let emoji, msg;
      if (finalScore === 10) { emoji = '🏆'; msg = 'სრულყოფილი! შენ ჩემპიონი ხარ!'; }
      else if (finalScore >= 8) { emoji = '🌟'; msg = 'შესანიშნავი შედეგი!'; }
      else if (finalScore >= 6) { emoji = '👍'; msg = 'კარგია! გააგრძელე სწავლა!'; }
      else if (finalScore >= 4) { emoji = '💪'; msg = 'შეგიძლია უკეთესი! ივარჯიშე მეტი.'; }
      else { emoji = '📚'; msg = 'არ დანებდე! ყოველდღე ვარჯიში დაგეხმარება.'; }

      document.getElementById('result-emoji').textContent = emoji;
      document.getElementById('result-message').textContent = msg;

      if (!isNew) {
        document.getElementById('result-message').textContent += ' (დღეს უკვე გაიარე!)';
      }

      document.getElementById('progress-fill').style.width = '100%';
    }
  </script>
