<script>
  let currentAudio: HTMLAudioElement | null = null;
  const FREE_CATEGORIES = 5;

  // ---- SOUND EFFECTS (same as games page) ----
  let actx: AudioContext | null = null;
  function snd(ok: boolean) {
    try {
      if (!actx) actx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (actx.state === 'suspended') actx.resume();
      const o = actx.createOscillator(), g = actx.createGain();
      o.connect(g); g.connect(actx.destination);
      g.gain.setValueAtTime(0.13, actx.currentTime);
      o.type = 'sine';
      if (ok) {
        o.frequency.setValueAtTime(523, actx.currentTime);
        o.frequency.setValueAtTime(659, actx.currentTime + 0.1);
      } else {
        o.frequency.setValueAtTime(330, actx.currentTime);
        o.frequency.setValueAtTime(262, actx.currentTime + 0.15);
      }
      g.gain.exponentialRampToValueAtTime(0.001, actx.currentTime + 0.3);
      o.start(actx.currentTime);
      o.stop(actx.currentTime + 0.35);
    } catch(e) {}
  }
  function playCorrectSound() { snd(true); }
  function playWrongSound() { snd(false); }
  function playMatchSound() { snd(true); }
  function playWinSound() { snd(true); }

  // ---- CONFETTI ----
  function spawnConfetti(container: Element) {
    const colors = ['#D4A853', '#22c55e', '#3b82f6', '#ef4444', '#a855f7', '#f97316', '#ec4899'];
    const rect = container.getBoundingClientRect();
    for (let i = 0; i < 30; i++) {
      const particle = document.createElement('div');
      particle.className = 'confetti-particle';
      particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      particle.style.left = Math.random() * 100 + '%';
      particle.style.top = '40%';
      particle.style.animationDelay = Math.random() * 0.4 + 's';
      particle.style.animationDuration = (0.8 + Math.random() * 0.8) + 's';
      const angle = (Math.random() - 0.5) * 120;
      particle.style.setProperty('--spread', angle + 'deg');
      container.querySelector('.confetti-zone')?.appendChild(particle);
    }
    setTimeout(() => {
      container.querySelectorAll('.confetti-particle').forEach(p => p.remove());
    }, 2000);
  }

  function speakEnglish(text: string, phraseId?: string) {
    if (phraseId) {
      const src = `/audio/phrases/${phraseId}.mp3`;
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      currentAudio = new Audio(src);
      currentAudio.play().catch(() => {
        // fallback to browser TTS if mp3 missing
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        u.lang = 'en-US';
        u.rate = 0.85;
        speechSynthesis.speak(u);
      });
      return;
    }
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'en-US';
    u.rate = 0.85;
    speechSynthesis.speak(u);
  }

  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function getPhrases(block: Element): any[] {
    try { return JSON.parse((block as HTMLElement).dataset.phrases || '[]'); } catch { return []; }
  }

  function pickRandom<T>(arr: T[], n: number, exclude?: T): T[] {
    const filtered = exclude ? arr.filter(x => x !== exclude) : [...arr];
    return shuffle(filtered).slice(0, n);
  }

  // ---- QUIZ ----
  function initQuiz(block: Element) {
    const phrases = getPhrases(block);
    if (phrases.length < 4) return;
    const container = block.querySelector('.quiz-container')!;
    let questions: any[] = [];
    let current = 0, score = 0, streak = 0, bestStreak = 0;
    const total = Math.min(10, phrases.length);

    function generateQuestions() {
      const picked = shuffle(phrases).slice(0, total);
      questions = picked.map(p => {
        const isGeoToEng = Math.random() > 0.5;
        const wrongPool = phrases.filter(x => x.id !== p.id);
        const wrongs = shuffle(wrongPool).slice(0, 3);
        const options = shuffle([
          ...(isGeoToEng ? [p.english] : [p.georgian]),
          ...wrongs.map(w => isGeoToEng ? w.english : w.georgian)
        ]);
        return { phrase: p, isGeoToEng, options, correct: isGeoToEng ? p.english : p.georgian };
      });
    }

    function render() {
      if (current >= questions.length) {
        const pct = score / total;
        const isGreat = pct >= 0.8;
        if (isGreat) { playWinSound(); }
        container.innerHTML = `
          <div class="text-center py-8 relative" style="animation: slideUp 0.5s ease">
            <div class="confetti-zone absolute inset-0 overflow-hidden pointer-events-none"></div>
            <div class="text-6xl mb-4 result-anim">${isGreat ? '🏆' : pct >= 0.5 ? '👍' : '📚'}</div>
            <h3 class="text-2xl font-bold text-[#E8E8E0] mb-2 score-anim">შედეგი: ${score}/${total}</h3>
            <p class="text-[#8B8B85] mb-1">საუკეთესო სერია: ${bestStreak} 🔥</p>
            <p class="text-[#8B8B85] mb-6">${isGreat ? '🎉 შესანიშნავი!' : pct >= 0.5 ? 'კარგია, გააგრძელე!' : 'გაიმეორე კიდევ ერთხელ!'}</p>
            <button class="quiz-restart bg-gradient-to-r from-[#D4A853] to-[#E8C06A] text-black font-bold py-3.5 px-10 rounded-xl hover:shadow-lg hover:shadow-[#D4A853]/20 transition-all duration-200 hover:scale-105 active:scale-95 text-base">🔄 თავიდან</button>
          </div>`;
        if (isGreat) {
          setTimeout(() => spawnConfetti(container), 200);
        }
        container.querySelector('.quiz-restart')?.addEventListener('click', () => { current = 0; score = 0; streak = 0; bestStreak = 0; generateQuestions(); render(); });
        return;
      }
      const q = questions[current];
      const prompt = q.isGeoToEng ? q.phrase.georgian : q.phrase.english;
      const dir = q.isGeoToEng ? 'ქართული → ინგლისური' : 'ინგლისური → ქართული';
      container.innerHTML = `
        <div class="mb-4 flex items-center justify-between flex-wrap gap-2" style="animation: slideUp 0.3s ease">
          <span class="text-xs text-[#6B6B65] font-medium">${dir}</span>
          <div class="flex items-center gap-3">
            ${streak >= 2 ? `<span class="streak-badge">🔥 ${streak}</span>` : ''}
            <span class="text-sm text-[#C8C8C0] font-bold">${current + 1}/${total}</span>
          </div>
        </div>
        <div class="progress-bar mb-6"><div class="progress-fill" style="width:${(current / total) * 100}%"></div></div>
        <div class="question-card mb-6" style="animation: slideUp 0.4s ease">
          <p class="text-xl sm:text-2xl font-bold text-[#E8E8E0]">${prompt}</p>
        </div>
        <div class="space-y-3" id="quizOptions">
          ${q.options.map((opt: string, i: number) => `
            <button class="quiz-option w-full text-left p-4 rounded-xl text-[#E8E8E0]" data-idx="${i}" style="animation: slideUp ${0.4 + i * 0.08}s ease">${opt}</button>
          `).join('')}
        </div>`;
      container.querySelectorAll('.quiz-option').forEach(btn => {
        btn.addEventListener('click', () => {
          if (container.querySelector('.quiz-option.correct,.quiz-option.wrong')) return;
          const picked = btn.textContent!.trim();
          const isCorrect = picked === q.correct;
          if (isCorrect) {
            score++; streak++; bestStreak = Math.max(bestStreak, streak);
            btn.classList.add('correct');
            playCorrectSound();
          } else {
            streak = 0;
            btn.classList.add('wrong');
            playWrongSound();
            // Reveal correct answer
            container.querySelectorAll('.quiz-option').forEach(b => {
              if (b.textContent!.trim() === q.correct) b.classList.add('correct-reveal');
            });
          }
          setTimeout(() => { current++; render(); }, 1400);
        });
      });
    }

    generateQuestions();
    render();
  }

  // ---- LISTEN ----
  function initListen(block: Element) {
    const phrases = getPhrases(block);
    if (phrases.length < 4) return;
    const container = block.querySelector('.listen-container')!;
    let questions: any[] = [];
    let current = 0, score = 0, streak = 0, bestStreak = 0;
    const total = Math.min(10, phrases.length);

    function generate() {
      const picked = shuffle(phrases).slice(0, total);
      questions = picked.map(p => {
        const wrongs = shuffle(phrases.filter(x => x.id !== p.id)).slice(0, 3);
        const options = shuffle([p.georgian, ...wrongs.map(w => w.georgian)]);
        return { phrase: p, options, correct: p.georgian };
      });
    }

    function render() {
      if (current >= questions.length) {
        const pct = score / total;
        const isGreat = pct >= 0.8;
        if (isGreat) { playWinSound(); }
        container.innerHTML = `
          <div class="text-center py-8 relative" style="animation: slideUp 0.5s ease">
            <div class="confetti-zone absolute inset-0 overflow-hidden pointer-events-none"></div>
            <div class="text-6xl mb-4 result-anim">${isGreat ? '🎧' : '📚'}</div>
            <h3 class="text-2xl font-bold text-[#E8E8E0] mb-2 score-anim">შედეგი: ${score}/${total}</h3>
            <p class="text-[#8B8B85] mb-1">საუკეთესო სერია: ${bestStreak} 🔥</p>
            <p class="text-[#8B8B85] mb-6">${isGreat ? '🎉 შესანიშნავი!' : 'გაიმეორე კიდევ ერთხელ!'}</p>
            <button class="listen-restart bg-gradient-to-r from-[#D4A853] to-[#E8C06A] text-black font-bold py-3.5 px-10 rounded-xl hover:shadow-lg hover:shadow-[#D4A853]/20 transition-all duration-200 hover:scale-105 active:scale-95 text-base">🔄 თავიდან</button>
          </div>`;
        if (isGreat) {
          setTimeout(() => spawnConfetti(container), 200);
        }
        container.querySelector('.listen-restart')?.addEventListener('click', () => { current = 0; score = 0; streak = 0; bestStreak = 0; generate(); render(); });
        return;
      }
      const q = questions[current];
      container.innerHTML = `
        <div class="mb-4 flex items-center justify-between flex-wrap gap-2" style="animation: slideUp 0.3s ease">
          <span class="text-xs text-[#6B6B65] font-medium">მოუსმინე და აირჩიე სწორი თარგმანი</span>
          <div class="flex items-center gap-3">
            ${streak >= 2 ? `<span class="streak-badge">🔥 ${streak}</span>` : ''}
            <span class="text-sm text-[#C8C8C0] font-bold">${current + 1}/${total}</span>
          </div>
        </div>
        <div class="progress-bar mb-6"><div class="progress-fill" style="width:${(current / total) * 100}%"></div></div>
        <div class="text-center mb-6" style="animation: slideUp 0.4s ease">
          <button class="listen-play-btn w-24 h-24 rounded-full text-[#D4A853] text-4xl mx-auto flex items-center justify-center">🔊</button>
          <p class="text-xs text-[#6B6B65] mt-3 font-medium">დააჭირე მოსასმენად</p>
        </div>
        <div class="space-y-3">
          ${q.options.map((opt: string, i: number) => `
            <button class="quiz-option w-full text-left p-4 rounded-xl text-[#E8E8E0]" data-idx="${i}" style="animation: slideUp ${0.4 + i * 0.08}s ease">${opt}</button>
          `).join('')}
        </div>`;
      // Auto-play
      setTimeout(() => speakEnglish(q.phrase.english, q.phrase.id), 300);
      container.querySelector('.listen-play-btn')?.addEventListener('click', () => speakEnglish(q.phrase.english, q.phrase.id));
      container.querySelectorAll('.quiz-option').forEach(btn => {
        btn.addEventListener('click', () => {
          if (container.querySelector('.quiz-option.correct,.quiz-option.wrong')) return;
          const picked = btn.textContent!.trim();
          const isCorrect = picked === q.correct;
          if (isCorrect) {
            score++; streak++; bestStreak = Math.max(bestStreak, streak);
            btn.classList.add('correct');
            playCorrectSound();
          } else {
            streak = 0;
            btn.classList.add('wrong');
            playWrongSound();
            container.querySelectorAll('.quiz-option').forEach(b => {
              if (b.textContent!.trim() === q.correct) b.classList.add('correct-reveal');
            });
          }
          setTimeout(() => { current++; render(); }, 1400);
        });
      });
    }

    generate();
    render();
  }

  // ---- MATCH ----
  function initMatch(block: Element) {
    const phrases = getPhrases(block);
    if (phrases.length < 5) return;
    const container = block.querySelector('.match-container')!;
    let pairs: any[] = [], selectedLeft: number | null = null, selectedRight: number | null = null;
    let matched = new Set<number>(), score = 0, errors = 0, startTime = 0, timerInterval: any = null;

    function start() {
      pairs = shuffle(phrases).slice(0, 5);
      matched = new Set(); score = 0; errors = 0; selectedLeft = null; selectedRight = null;
      startTime = Date.now();
      render();
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(updateTimer, 100);
    }

    function updateTimer() {
      const el = container.querySelector('.match-timer');
      if (el) { const s = ((Date.now() - startTime) / 1000).toFixed(1); el.textContent = s + 'წმ'; }
    }

    function render() {
      const leftOrder = shuffle(pairs.map((_, i) => i));
      const rightOrder = shuffle(pairs.map((_, i) => i));
      container.innerHTML = `
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm text-[#C8C8C0] font-bold">დაწყვილებული: ${matched.size}/${pairs.length}</span>
          <div class="flex items-center gap-3">
            <span class="text-sm text-[#6B6B65] match-timer font-medium">0.0წმ</span>
            <span class="text-sm text-[#C8C8C0] font-bold">⭐ ${score}</span>
          </div>
        </div>
        <div class="progress-bar mb-5"><div class="progress-fill" style="width:${(matched.size / pairs.length) * 100}%"></div></div>
        <div class="grid grid-cols-2 gap-3">
          <div class="space-y-2">
            ${leftOrder.map(i => `<button class="match-item match-left w-full p-3.5 rounded-xl text-sm text-left font-medium ${matched.has(i) ? 'matched' : ''}" data-pair="${i}">${pairs[i].english}</button>`).join('')}
          </div>
          <div class="space-y-2">
            ${rightOrder.map(i => `<button class="match-item match-right w-full p-3.5 rounded-xl text-sm text-left font-medium ${matched.has(i) ? 'matched' : ''}" data-pair="${i}">${pairs[i].georgian}</button>`).join('')}
          </div>
        </div>`;

      container.querySelectorAll('.match-left:not(.matched)').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.match-left').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedLeft = parseInt((btn as HTMLElement).dataset.pair!);
          checkMatch();
        });
      });
      container.querySelectorAll('.match-right:not(.matched)').forEach(btn => {
        btn.addEventListener('click', () => {
          container.querySelectorAll('.match-right').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedRight = parseInt((btn as HTMLElement).dataset.pair!);
          checkMatch();
        });
      });
    }

    function checkMatch() {
      if (selectedLeft === null || selectedRight === null) return;
      const l = selectedLeft, r = selectedRight;
      selectedLeft = null; selectedRight = null;
      if (l === r) {
        score++;
        matched.add(l);
        playMatchSound();
        container.querySelectorAll(`.match-left[data-pair="${l}"],.match-right[data-pair="${r}"]`).forEach(el => { el.classList.add('matched'); el.classList.remove('selected'); });
        if (matched.size === pairs.length) {
          clearInterval(timerInterval);
          const time = ((Date.now() - startTime) / 1000).toFixed(1);
          playWinSound();
          setTimeout(() => {
            container.innerHTML = `
              <div class="text-center py-8 relative" style="animation: slideUp 0.5s ease">
                <div class="confetti-zone absolute inset-0 overflow-hidden pointer-events-none"></div>
                <div class="text-6xl mb-4 result-anim">🎉</div>
                <h3 class="text-2xl font-bold text-[#E8E8E0] mb-2 score-anim">დასრულებულია!</h3>
                <p class="text-[#8B8B85] mb-1">⏱ ${time} წამი · ❌ ${errors} შეცდომა</p>
                <button class="match-restart bg-gradient-to-r from-[#D4A853] to-[#E8C06A] text-black font-bold py-3.5 px-10 rounded-xl hover:shadow-lg hover:shadow-[#D4A853]/20 transition-all duration-200 hover:scale-105 active:scale-95 mt-4 text-base">🔄 თავიდან</button>
              </div>`;
            spawnConfetti(container);
            container.querySelector('.match-restart')?.addEventListener('click', start);
          }, 600);
        }
      } else {
        errors++;
        playWrongSound();
        const leftEl = container.querySelector(`.match-left[data-pair="${l}"]`);
        const rightEl = container.querySelector(`.match-right[data-pair="${r}"]`);
        [leftEl, rightEl].forEach(el => { if (el) { el.classList.add('wrong-flash'); el.classList.remove('selected'); } });
        setTimeout(() => { [leftEl, rightEl].forEach(el => { if (el) el.classList.remove('wrong-flash'); }); }, 600);
      }
    }

    start();
  }

  // ---- TAB SWITCHING ----
  document.querySelectorAll('.category-block').forEach(block => {
    const isPremium = (block as HTMLElement).dataset.premium === 'true';
    const isPremiumUser = localStorage.getItem('fluentge-premium') === 'true';
    const tabs = block.querySelectorAll('.mode-tab');
    const panels = block.querySelectorAll('.mode-panel');
    const initialized: Record<string, boolean> = {};

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const mode = (tab as HTMLElement).dataset.mode!;
        if (isPremium && !isPremiumUser && mode !== 'phrases') {
          document.getElementById('premiumModal')?.classList.remove('hidden');
          return;
        }
        tabs.forEach(t => { t.classList.remove('active'); });
        tab.classList.add('active');
        panels.forEach(p => { (p as HTMLElement).style.display = 'none'; });
        const panel = block.querySelector(`[data-panel="${mode}"]`) as HTMLElement;
        if (panel) panel.style.display = '';
        if (mode === 'quiz' && !initialized.quiz) { initialized.quiz = true; initQuiz(block); }
        if (mode === 'listen' && !initialized.listen) { initialized.listen = true; initListen(block); }
        if (mode === 'match' && !initialized.match) { initialized.match = true; initMatch(block); }
      });
    });
  });

  // Play audio
  document.querySelectorAll('.play-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const src = (btn as HTMLElement).dataset.audio;
      if (!src) return;
      if (currentAudio) { currentAudio.pause(); currentAudio = null; }
      currentAudio = new Audio(src);
      currentAudio.play().catch(() => {
        const text = btn.closest('.phrase-item')?.querySelector('.text-lg, .font-semibold')?.textContent;
        if (text) speakEnglish(text);
      });
    });
  });

  // Toggle free categories
  document.querySelectorAll('.cat-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const block = btn.closest('.category-block');
      const content = block?.querySelector('.cat-content');
      const arrow = block?.querySelector('.cat-arrow');
      if (content && arrow) {
        content.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
      }
    });
  });

  // Unlock premium for premium users
  const isPremiumUser = localStorage.getItem('fluentge-premium') === 'true';
  if (isPremiumUser) {
    document.querySelectorAll('.premium-locked').forEach(el => el.classList.remove('premium-locked'));
    document.querySelectorAll('.premium-phrases-hidden').forEach(el => el.classList.remove('premium-phrases-hidden'));
    document.querySelectorAll('.premium-toggle').forEach(btn => {
      btn.classList.remove('premium-toggle');
      btn.classList.add('cat-toggle');
      const title = btn.querySelector('h2');
      if (title) { title.classList.remove('text-[#6B6B65]'); title.classList.add('text-[#E8E8E0]'); }
      const badge = btn.querySelector('.text-\\[\\#D4A853\\]');
      if (badge) { badge.outerHTML = '<svg class="w-5 h-5 text-[#6B6B65] cat-arrow transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>'; }
    });
    document.querySelectorAll('.category-block[data-premium="true"] .cat-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const block = btn.closest('.category-block');
        const content = block?.querySelector('.cat-content');
        if (content) content.classList.toggle('hidden');
      });
    });
  }

  // Premium categories → show paywall
  const modal = document.getElementById('premiumModal');
  document.querySelectorAll('.premium-toggle').forEach(btn => {
    btn.addEventListener('click', () => modal?.classList.remove('hidden'));
  });
  document.getElementById('closeModal')?.addEventListener('click', () => modal?.classList.add('hidden'));
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

  // Search
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    document.querySelectorAll('.phrase-item').forEach(el => {
      const en = (el as HTMLElement).dataset.en || '';
      const ka = (el as HTMLElement).dataset.ka || '';
      const match = !q || en.includes(q) || ka.includes(q);
      (el as HTMLElement).style.display = match ? '' : 'none';
    });
    document.querySelectorAll('.category-block').forEach(block => {
      const list = block.querySelector('.phrases-list');
      if (!list) return;
      const visiblePhrases = list.querySelectorAll('.phrase-item:not([style*="display: none"])');
      (block as HTMLElement).style.display = visiblePhrases.length > 0 || !q ? '' : 'none';
      if (q && visiblePhrases.length > 0) {
        block.querySelector('.cat-content')?.classList.remove('hidden');
        block.querySelector('.cat-arrow')?.classList.add('rotate-180');
      }
    });
  });

  // Level filter
  document.querySelectorAll('.level-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.level-btn').forEach(b => {
        b.classList.remove('active');
        b.classList.remove('bg-[#D4A853]', 'text-black', 'font-bold', 'border-[#D4A853]');
        b.classList.add('bg-[#1C1C1E]', 'text-[#C8C8C0]', 'border-[#2E2E30]');
      });
      btn.classList.add('active', 'bg-[#D4A853]', 'text-black', 'font-bold', 'border-[#D4A853]');
      btn.classList.remove('bg-[#1C1C1E]', 'text-[#C8C8C0]', 'border-[#2E2E30]');
      const level = (btn as HTMLElement).dataset.level;
      document.querySelectorAll('.phrase-item').forEach(el => {
        const phraseLevel = (el as HTMLElement).dataset.level;
        const match = level === 'all' || phraseLevel === level;
        (el as HTMLElement).style.display = match ? '' : 'none';
      });
      document.querySelectorAll('.category-block').forEach(block => {
        const list = block.querySelector('.phrases-list');
        if (!list) return;
        const visiblePhrases = list.querySelectorAll('.phrase-item:not([style*="display: none"])');
        (block as HTMLElement).style.display = visiblePhrases.length > 0 ? '' : 'none';
      });
    });
  });
</script>
