---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const grammarDir = path.resolve('..', 'content', 'grammar');
const files = fs.readdirSync(grammarDir).filter(f => f.endsWith('.json')).sort();
const lessons = files.map(f => JSON.parse(fs.readFileSync(path.join(grammarDir, f), 'utf-8')));

const grouped: Record<string, typeof lessons> = {};
for (const lesson of lessons) {
  const level = lesson.level || 'A1';
  if (!grouped[level]) grouped[level] = [];
  grouped[level].push(lesson);
}
const levels = Object.keys(grouped).sort();

// Build ordered lesson list for sequential unlock
const allLessonsOrdered: typeof lessons = [];
for (const level of levels) {
  allLessonsOrdered.push(...grouped[level]);
}

// A1 lessons are always free; other levels unlock via placement test
function isLessonFree(slug: string) {
  const lesson = allLessonsOrdered.find(l => l.slug === slug);
  return lesson?.level === 'A1';
}
---

<Layout title="ინგლისური გრამატიკა ქართულად | FluentGe" description="65 ინტერაქტიული გრამატიკის გაკვეთილი ქართულ ენაზე — A1-დან C1-მდე. ტესტები, სავარჯიშოები და XP სისტემა. 8 გაკვეთილი უფასოა!">
  <style is:global>
    .light .grammar-level-bar { background: #e5e7eb !important; }
    .light .grammar-level-counter { color: #6b7280 !important; }
  </style>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?w=1400&q=80" alt="" class="w-full h-full object-cover opacity-30"/>
      <div class="absolute inset-0 bg-gradient-to-b from-[#1C1C1E]/60 to-[#1C1C1E]"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 pt-24 pb-16 text-center">
      <h1 class="font-['Playfair_Display',serif] text-3xl sm:text-4xl md:text-5xl mb-4 leading-tight">გრამატიკა</h1>
      <p class="text-base sm:text-lg text-[#A0A09A] max-w-xl mx-auto">ისწავლე ინგლისური გრამატიკა ნაბიჯ-ნაბიჯ</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">

    <!-- Grammar Review CTA (shown when user has completed lessons) -->
    <div id="grammar-review-cta" class="grammar-review-cta hidden" style="cursor:pointer;">
      <div class="grammar-review-icon">🔄</div>
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-0.5">
          <span class="font-bold text-lg">გრამატიკის გამეორება</span>
          <span class="grammar-review-count" id="grammar-review-count">0</span>
        </div>
        <p class="text-sm text-[#A0A09A]">გაიმეორე გავლილი გაკვეთილები — განამტკიცე ცოდნა</p>
      </div>
      <span class="text-2xl">→</span>
    </div>

    {levels.map(level => (
      <div class="mb-12">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-2xl font-bold flex items-center gap-3">
            <span class={`px-3 py-1 rounded-full text-sm font-bold ${level === 'A1' ? 'bg-green-500/20 text-green-400' : level === 'A2' ? 'bg-blue-500/20 text-blue-400' : level === 'B1' ? 'bg-yellow-500/20 text-yellow-400' : level === 'B2' ? 'bg-orange-500/20 text-orange-400' : 'bg-purple-500/20 text-purple-400'}`}>{level}</span>
            <span>{level === 'A1' ? 'დამწყები' : level === 'A2' ? 'ელემენტარული' : level === 'B1' ? 'საშუალო' : level === 'B2' ? 'საშუალო+' : level === 'C1' ? 'მოწინავე' : level}</span>
          </h2>
          <span class="text-xs text-[#6B6B65] font-medium grammar-level-counter" data-level={level} data-total={grouped[level].length}>
            0/{grouped[level].length} გავლილი
          </span>
        </div>
        <div class="w-full h-2 bg-[#2E2E30] rounded-full mb-5 overflow-hidden grammar-level-bar" data-bar-level={level}>
          <div class={`h-full rounded-full transition-all duration-700 ${level === 'A1' ? 'bg-green-500' : level === 'A2' ? 'bg-blue-500' : level === 'B1' ? 'bg-yellow-500' : level === 'B2' ? 'bg-orange-500' : 'bg-purple-500'}`} style="width: 0%" data-bar-fill={level}></div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {grouped[level].map(lesson => {
            const free = isLessonFree(lesson.slug);
            const globalIdx = allLessonsOrdered.indexOf(lesson);
            return (
              <a href={free ? `/grammar/${lesson.slug}/` : '/placement/'} 
                 class={`grammar-lesson-card block border border-b-4 rounded-xl p-5 transition-all ${free ? 'bg-[#242426] hover:bg-[#2E2E30] border-[#2E2E30] border-b-[#1a1a1c] hover:scale-[1.02] active:border-b-2 active:mt-[2px]' : 'bg-[#242426] border-white/5 border-b-[#1a1a1c] opacity-60 hover:opacity-80 hover:border-sky-500/30'}`}
                 data-slug={lesson.slug}
                 data-idx={globalIdx}
                 data-free={free ? 'true' : 'false'}
                 data-level={lesson.level}
                 data-lesson-url={`/grammar/${lesson.slug}/`}>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="grammar-lesson-status text-xl flex-shrink-0" data-status-idx={globalIdx}>📖</span>
                    <h3 class="font-semibold text-base sm:text-lg leading-snug break-words">{lesson.title_ka}</h3>
                  </div>
                  <div class="flex items-center gap-1 flex-shrink-0">
                    <span class="grammar-lesson-badge text-xs px-2 py-0.5 rounded-full font-medium whitespace-nowrap" data-badge-idx={globalIdx}>
                      {free ? '✅ უფასო' : '🔒'}
                    </span>
                    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${level === 'A1' ? 'bg-green-500/20 text-green-400' : level === 'A2' ? 'bg-blue-500/20 text-blue-400' : level === 'B1' ? 'bg-yellow-500/20 text-yellow-400' : level === 'B2' ? 'bg-orange-500/20 text-orange-400' : 'bg-purple-500/20 text-purple-400'}`}>{level}</span>
                  </div>
                </div>
                <p class="text-[#6B6B65] text-sm">{lesson.title_en}</p>
                <div class="grammar-lesson-footer mt-3 text-xs text-[#6B6B65]" data-footer-idx={globalIdx}>
                  📝 {lesson.exercises.length} სავარჯიშო
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}

    <!-- Placement Test CTA -->
    <div id="placement-cta" class="mt-8 bg-gradient-to-r from-sky-500/10 to-green-500/10 border border-sky-500/20 rounded-2xl p-8 text-center">
      <h3 class="text-2xl font-bold mb-2">🎯 გახსენი შენი დონის გაკვეთილები</h3>
      <p class="text-[#6B6B65] mb-6">გაიარე დონის ტესტი და გაიხსნება შენი დონის ყველა გრამატიკის გაკვეთილი</p>
      <a href="/placement/" class="inline-block bg-sky-500 hover:bg-sky-400 text-white font-bold py-3 px-8 rounded-xl text-lg transition-colors border-b-4 border-sky-600 active:border-b-2 active:mt-[2px]">
        🎯 დონის ტესტი
      </a>
    </div>
  </section>

  <script>
    // Grammar Review CTA
    (function() {
      try {
        var completed = JSON.parse(localStorage.getItem('fluentge-grammar-completed') || '{}');
        var slugs = Object.keys(completed);
        if (slugs.length >= 3) {
          var cta = document.getElementById('grammar-review-cta');
          var count = document.getElementById('grammar-review-count');
          if (cta) {
            cta.classList.remove('hidden');
            count.textContent = slugs.length;
            // Pick lesson that needs review most (SRS-like: least recently reviewed first)
            cta.addEventListener('click', function() {
              var reviews = {};
              try { reviews = JSON.parse(localStorage.getItem('fluentge-grammar-reviews') || '{}'); } catch(e) {}
              // Sort: never reviewed first, then oldest review date
              var sorted = slugs.slice().sort(function(a, b) {
                var da = reviews[a] ? new Date(reviews[a]).getTime() : 0;
                var db = reviews[b] ? new Date(reviews[b]).getTime() : 0;
                return da - db;
              });
              // Pick from top 3 least-reviewed (some randomness)
              var pick = sorted[Math.floor(Math.random() * Math.min(3, sorted.length))];
              window.location.href = '/grammar/' + pick + '/?review=1';
            });
          }
        }
      } catch(e) {}
    })();

    // Grammar level progress bars
    (function() {
      var completed = {};
      try { completed = JSON.parse(localStorage.getItem('fluentge-grammar-completed') || '{}'); } catch(e) {}
      if (Array.isArray(completed)) { var obj = {}; completed.forEach(function(s) { obj[s] = true; }); completed = obj; }
      // Count per level
      var levelCounts = {};
      document.querySelectorAll('.grammar-lesson-card').forEach(function(card) {
        // Find parent level section
        var section = card.closest('.mb-12');
        if (!section) return;
        var bar = section.querySelector('[data-bar-level]');
        if (!bar) return;
        var level = bar.dataset.barLevel;
        if (!levelCounts[level]) levelCounts[level] = 0;
        if (completed[card.dataset.slug]) levelCounts[level]++;
      });
      // Update UI
      document.querySelectorAll('.grammar-level-counter').forEach(function(el) {
        var level = el.dataset.level;
        var total = parseInt(el.dataset.total, 10);
        var done = levelCounts[level] || 0;
        el.textContent = done + '/' + total + ' გავლილი';
      });
      document.querySelectorAll('[data-bar-fill]').forEach(function(el) {
        var level = el.dataset.barFill;
        var barContainer = el.closest('.grammar-level-bar');
        var total = 0;
        var counter = document.querySelector('.grammar-level-counter[data-level="' + level + '"]');
        if (counter) total = parseInt(counter.dataset.total, 10);
        var done = levelCounts[level] || 0;
        var pct = total > 0 ? Math.round((done / total) * 100) : 0;
        setTimeout(function() { el.style.width = pct + '%'; }, 200);
      });
    })();

    // Sequential Lock/Unlock System
    (function() {
      var LEVEL_ORDER = ['A1', 'A2', 'B1', 'B2', 'C1'];
      var isPremium = localStorage.getItem('fluentge-premium') === 'true';
      var placementLevel = localStorage.getItem('fluentge-placement-level');
      var placementIdx = placementLevel ? LEVEL_ORDER.indexOf(placementLevel) : -1;
      var isLight = document.documentElement.classList.contains('light');
      var completed = {};
      try { completed = JSON.parse(localStorage.getItem('fluentge-grammar-completed') || '{}'); } catch(e) {}
      // Migrate old array format
      if (Array.isArray(completed)) {
        var obj = {};
        completed.forEach(function(s) { obj[s] = true; });
        completed = obj;
        localStorage.setItem('fluentge-grammar-completed', JSON.stringify(completed));
      }
      
      // Get all lesson slugs in order
      var allSlugs = [];
      document.querySelectorAll('.grammar-lesson-card').forEach(function(card) {
        allSlugs.push(card.dataset.slug);
      });
      
      // A lesson is unlocked if:
      // 1. It's A1 (always free)
      // 2. Its level <= placement test level
      // 3. Premium user
      // 4. Sequential: previous lesson completed
      var prevCompleted = true;
      
      document.querySelectorAll('.grammar-lesson-card').forEach(function(card) {
        var slug = card.dataset.slug;
        var idx = parseInt(card.dataset.idx);
        var isFree = card.dataset.free === 'true';
        var isCompleted = !!completed[slug];
        
        // Check if lesson's level is unlocked by placement test
        var lessonLevel = card.dataset.level;
        var lessonLevelIdx = lessonLevel ? LEVEL_ORDER.indexOf(lessonLevel) : -1;
        var unlockedByPlacement = placementIdx >= 0 && lessonLevelIdx >= 0 && lessonLevelIdx <= placementIdx;
        
        var isUnlocked = prevCompleted || isCompleted || unlockedByPlacement;
        var statusEl = card.querySelector('.grammar-lesson-status');
        var badgeEl = card.querySelector('.grammar-lesson-badge');
        var footerEl = card.querySelector('.grammar-lesson-footer');
        
        if (isCompleted) {
          // ✅ Completed state — GREEN tint, checkmark, clearly done
          statusEl.textContent = '✅';
          statusEl.style.fontSize = '1.5rem';
          badgeEl.textContent = 'გავლილი ✓';
          badgeEl.className = 'grammar-lesson-badge text-xs px-2.5 py-1 rounded-full font-bold bg-green-500/20 text-green-400 border border-green-500/30';
          card.classList.remove('opacity-60');
          card.classList.add('hover:scale-[1.02]');
          card.style.borderLeftColor = 'rgb(34, 197, 94)';
          card.style.borderLeftWidth = '4px';
          card.style.background = isLight ? 'linear-gradient(135deg, rgba(34,197,94,0.06) 0%, rgba(255,255,255,1) 100%)' : 'linear-gradient(135deg, rgba(34,197,94,0.08) 0%, rgba(36,36,38,1) 100%)';
          card.setAttribute('href', '/grammar/' + slug + '/');
          var exCount = footerEl.textContent.match(/\d+/)?.[0] || '';
          footerEl.innerHTML = '<span style="color:rgb(74,222,128)">✅ გავლილი</span> · 📝 ' + exCount + ' სავარჯიშო';
        } else if (isUnlocked && (isFree || isPremium || unlockedByPlacement)) {
          // ▶ Current lesson — BLUE glow, pulsing, call-to-action
          statusEl.textContent = '▶️';
          statusEl.style.fontSize = '1.5rem';
          badgeEl.textContent = '📍 მიმდინარე';
          badgeEl.className = 'grammar-lesson-badge text-xs px-2.5 py-1 rounded-full font-bold bg-sky-500/25 text-sky-300 border border-sky-400/40 animate-pulse';
          card.classList.remove('opacity-60');
          card.classList.add('hover:scale-[1.02]');
          card.style.borderColor = 'rgba(56, 189, 248, 0.5)';
          card.style.borderWidth = '2px';
          card.style.borderBottomWidth = '4px';
          card.style.boxShadow = '0 0 20px rgba(56, 189, 248, 0.15), inset 0 0 30px rgba(56, 189, 248, 0.03)';
          card.style.background = isLight ? 'linear-gradient(135deg, rgba(56,189,248,0.06) 0%, rgba(255,255,255,1) 100%)' : 'linear-gradient(135deg, rgba(56,189,248,0.08) 0%, rgba(36,36,38,1) 100%)';
          card.setAttribute('href', '/grammar/' + slug + '/');
          footerEl.innerHTML = '▶️ <strong style="color:rgb(125,211,252)">დაიწყე ახლა</strong>';
          footerEl.classList.remove('text-[#6B6B65]');
          footerEl.classList.add('text-sky-400', 'font-medium');
        } else if (!isCompleted && !isPremium && !isFree && !unlockedByPlacement) {
          // 🔒 Locked — needs placement test or premium
          statusEl.textContent = '👑';
          statusEl.style.fontSize = '1.25rem';
          statusEl.style.opacity = '0.6';
          badgeEl.textContent = '🔒 ჩაკეტილი';
          badgeEl.className = 'grammar-lesson-badge text-xs px-2.5 py-1 rounded-full font-bold bg-amber-500/15 text-amber-400/80 border border-amber-500/20';
          card.style.opacity = '0.55';
          card.setAttribute('href', '/placement/');
          footerEl.innerHTML = '🎯 გაიარე დონის ტესტი გასახსნელად';
          footerEl.classList.remove('text-[#6B6B65]');
          footerEl.classList.add('text-amber-400/70');
        } else if (!isCompleted) {
          // 🔒 Locked (sequential) — GRAY, faded, clearly not available
          statusEl.textContent = '🔒';
          statusEl.style.fontSize = '1rem';
          statusEl.style.opacity = '0.4';
          badgeEl.textContent = 'ჩაკეტილი';
          badgeEl.className = 'grammar-lesson-badge text-xs px-2.5 py-1 rounded-full font-medium bg-neutral-500/10 text-neutral-500 border border-neutral-500/15';
          card.classList.add('opacity-40');
          card.classList.remove('hover:scale-[1.02]');
          card.style.pointerEvents = 'none';
          card.style.filter = 'grayscale(0.5)';
          footerEl.innerHTML = '🔒 ჯერ წინა გაკვეთილი გაიარე';
          footerEl.classList.remove('text-[#6B6B65]');
          footerEl.classList.add('text-neutral-500');
        }
        prevCompleted = isCompleted;
      });
    })();
    
  </script>
</Layout>
