---
import Layout from '../layouts/Layout.astro';

const paths = [
  {
    id: 'beginner',
    level: 'A1–A2',
    title: 'დამწყები',
    titleEn: 'Beginner Path',
    icon: '🌱',
    color: 'from-green-400 to-emerald-500',
    border: 'border-green-500/30',
    bg: 'bg-green-500/10',
    textColor: 'text-green-400',
    desc: 'ნულიდან ინგლისურის საფუძვლებამდე. ისწავლე ძირითადი სიტყვები, მარტივი წინადადებები და ყოველდღიური გამოთქმები.',
    duration: '2-3 თვე',
    milestones: [
      { emoji: '👋', title: 'მისალმება & გაცნობა', desc: 'Hello, How are you, My name is...', link: '/flashcards/?deck=greetings', type: 'vocab', storageKey: 'greetings' },
      { emoji: '🔢', title: 'რიცხვები & ფერები', desc: 'Numbers 1-100, colors, basic counting', link: '/flashcards/?deck=numbers', type: 'vocab', storageKey: 'numbers' },
      { emoji: '📖', title: 'To Be — ყოფნის ზმნა', desc: 'I am, You are, He is...', link: '/grammar/to-be/', type: 'grammar', storageKey: 'to-be' },
      { emoji: '👨‍👩‍👧', title: 'ოჯახი & ადამიანები', desc: 'Mother, father, sister, friend...', link: '/flashcards/?deck=family', type: 'vocab', storageKey: 'family' },
      { emoji: '🍕', title: 'საკვები & სასმელი', desc: 'Food, drinks, restaurant ordering', link: '/flashcards/?deck=food', type: 'vocab', storageKey: 'food' },
      { emoji: '📖', title: 'Present Simple', desc: 'I eat, She works, They play...', link: '/grammar/present-simple/', type: 'grammar', storageKey: 'present-simple' },
      { emoji: '🐾', title: 'ცხოველები & ბუნება', desc: 'Cat, dog, tree, flower...', link: '/flashcards/?deck=animals', type: 'vocab', storageKey: 'animals' },
      { emoji: '🎧', title: 'აეროპორტში (პოდკასტი)', desc: 'Listen to real English conversations', link: '/podcast/#ep-1', type: 'podcast' },
      { emoji: '📝', title: 'ერთეულის ტესტი #1', desc: 'Test your A1 knowledge', link: '/flashcards/#unit-quiz/1', type: 'quiz' },
      { emoji: '🏆', title: '200 სიტყვა ნასწავლი!', desc: 'Milestone: You know 200 words', type: 'milestone', threshold: 200 },
    ]
  },
  {
    id: 'intermediate',
    level: 'B1–B2',
    title: 'საშუალო',
    titleEn: 'Intermediate Path',
    icon: '📚',
    color: 'from-sky-400 to-indigo-500',
    border: 'border-sky-500/30',
    bg: 'bg-sky-500/10',
    textColor: 'text-sky-400',
    desc: 'გააღრმავე ცოდნა. ისწავლე ბიზნეს ინგლისური, რთული გრამატიკა და გააფართოვე ლექსიკა.',
    duration: '3-4 თვე',
    milestones: [
      { emoji: '💼', title: 'ბიზნეს ინგლისური', desc: 'Meeting, deadline, presentation...', link: '/flashcards/?deck=business', type: 'vocab', storageKey: 'business' },
      { emoji: '📖', title: 'Past Simple', desc: 'I went, She worked, They played...', link: '/grammar/past-simple/', type: 'grammar', storageKey: 'past-simple' },
      { emoji: '💻', title: 'ტექნოლოგია', desc: 'Software, database, algorithm...', link: '/flashcards/?deck=technology', type: 'vocab', storageKey: 'technology' },
      { emoji: '📖', title: 'Present Perfect', desc: 'I have seen, She has been...', link: '/grammar/present-perfect/', type: 'grammar', storageKey: 'present-perfect' },
      { emoji: '🏥', title: 'ჯანმრთელობა', desc: 'Symptoms, diagnosis, treatment...', link: '/flashcards/?deck=health', type: 'vocab', storageKey: 'health' },
      { emoji: '📖', title: 'Modal Verbs', desc: 'Can, should, must, might...', link: '/grammar/modal-verbs/', type: 'grammar', storageKey: 'modal-verbs' },
      { emoji: '🎧', title: 'გასაუბრება სამსახურში', desc: 'Advanced listening practice', link: '/podcast/#ep-3', type: 'podcast' },
      { emoji: '🎮', title: 'ენის თამაშები', desc: 'Practice with fun games', link: '/games/', type: 'game' },
      { emoji: '📝', title: 'ერთეულის ტესტი #4', desc: 'Test your B1 knowledge', link: '/flashcards/#unit-quiz/4', type: 'quiz' },
      { emoji: '🏆', title: '500 სიტყვა ნასწავლი!', desc: 'Milestone: Conversational level', type: 'milestone', threshold: 500 },
    ]
  },
  {
    id: 'advanced',
    level: 'C1',
    title: 'მაღალი დონე',
    titleEn: 'Advanced Path',
    icon: '🎓',
    color: 'from-purple-400 to-pink-500',
    border: 'border-purple-500/30',
    bg: 'bg-purple-500/10',
    textColor: 'text-purple-400',
    desc: 'დახვეწე ენა პროფესიონალურ დონეზე. აკადემიური ლექსიკა, იდიომები, IELTS/TOEFL მომზადება.',
    duration: '3-6 თვე',
    milestones: [
      { emoji: '🎓', title: 'აკადემიური ინგლისური', desc: 'Research, hypothesis, methodology...', link: '/flashcards/?deck=academic', type: 'vocab', storageKey: 'academic' },
      { emoji: '📖', title: 'Conditionals', desc: 'If I were..., I would have...', link: '/grammar/conditionals/', type: 'grammar', storageKey: 'conditionals' },
      { emoji: '💡', title: 'იდიომები', desc: 'Break a leg, Piece of cake...', link: '/flashcards/?deck=idioms', type: 'vocab', storageKey: 'idioms' },
      { emoji: '🔗', title: 'Phrasal Verbs', desc: 'Look up, Give in, Turn out...', link: '/flashcards/?deck=phrasal-verbs', type: 'vocab', storageKey: 'phrasal-verbs' },
      { emoji: '📋', title: 'IELTS Reading Vocab', desc: 'Academic test preparation', link: '/flashcards/?deck=ielts-reading', type: 'vocab', storageKey: 'ielts-reading' },
      { emoji: '📋', title: 'IELTS Writing Vocab', desc: 'Essay linking words & phrases', link: '/flashcards/?deck=ielts-writing', type: 'vocab', storageKey: 'ielts-writing' },
      { emoji: '📋', title: 'TOEFL Speaking', desc: 'Discourse markers & opinions', link: '/flashcards/?deck=toefl-speaking', type: 'vocab', storageKey: 'toefl-speaking' },
      { emoji: '🎧', title: 'მაღალი დონის პოდკასტი', desc: 'Complex listening practice', link: '/podcast/#ep-31', type: 'podcast' },
      { emoji: '✏️', title: 'წერის სავარჯიშო', desc: 'Practice writing in English', link: '/flashcards/', type: 'writing' },
      { emoji: '🏆', title: '1000 სიტყვა ნასწავლი!', desc: 'Milestone: Near-fluent vocabulary', type: 'milestone', threshold: 1000 },
    ]
  }
];
---

<Layout title="სწავლის გზები — FluentGe" description="აირჩიე შენი სწავლის გზა: დამწყებიდან მაღალ დონემდე. FluentGe-ს სტრუქტურირებული პროგრამა ინგლისური ენის სწავლისთვის.">
  <style>
    .path-card {
      background: #1e1e22;
      border: 1px solid #2e2e32;
      border-radius: 1.5rem;
      overflow: hidden;
      transition: all 0.3s;
    }
    .path-card:hover { border-color: #4a4a50; }
    .path-header {
      padding: 1.5rem;
      cursor: pointer;
      user-select: none;
    }
    .path-header:hover { opacity: 0.9; }
    .milestone-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-top: 1px solid #2e2e32;
      transition: background 0.15s;
      text-decoration: none;
      color: inherit;
    }
    a.milestone-item:hover { background: #242428; }
    .milestone-dot {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      background: #2a2a2e;
      border: 2px solid #3a3a3e;
      position: relative;
    }
    .milestone-dot.completed {
      background: rgba(34, 197, 94, 0.15);
      border-color: #22c55e;
    }
    .milestone-dot.completed::after {
      content: '✓';
      position: absolute;
      top: -4px;
      right: -4px;
      width: 16px;
      height: 16px;
      background: #22c55e;
      border-radius: 50%;
      font-size: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
    }
    .milestone-connector {
      position: absolute;
      left: 50%;
      top: 100%;
      width: 2px;
      height: 1rem;
      background: #3a3a3e;
      transform: translateX(-50%);
    }
    .milestone-connector.completed { background: #22c55e; }
    .type-badge {
      display: inline-block;
      font-size: 0.6rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .type-vocab { background: rgba(34,197,94,0.15); color: #4ade80; }
    .type-grammar { background: rgba(59,130,246,0.15); color: #60a5fa; }
    .type-podcast { background: rgba(168,85,247,0.15); color: #c084fc; }
    .type-quiz { background: rgba(245,158,11,0.15); color: #fbbf24; }
    .type-game { background: rgba(236,72,153,0.15); color: #f472b6; }
    .type-writing { background: rgba(6,182,212,0.15); color: #22d3ee; }
    .type-milestone { background: rgba(255,215,0,0.15); color: #ffd700; }
    .progress-ring {
      width: 64px;
      height: 64px;
      flex-shrink: 0;
    }
    .chevron {
      transition: transform 0.3s;
      color: #6b7280;
    }
    .chevron.open { transform: rotate(180deg); }
    .path-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease-out;
    }
    .path-body.open {
      max-height: 2000px;
    }

    /* Light mode */
    :global(.light) .path-card { background: white; border-color: #e5e7eb; }
    :global(.light) .path-card:hover { border-color: #d1d5db; }
    :global(.light) .milestone-item { border-top-color: #f3f4f6; }
    :global(.light) a.milestone-item:hover { background: #f9fafb; }
    :global(.light) .milestone-dot { background: #f3f4f6; border-color: #d1d5db; }
    :global(.light) .milestone-dot.completed { background: rgba(34,197,94,0.1); }
    :global(.light) .milestone-connector { background: #d1d5db; }
    :global(.light) .chevron { color: #9ca3af; }
  </style>

  <!-- Hero -->
  <section class="text-center py-12 px-4">
    <h1 class="text-3xl font-extrabold mb-3">
      🗺️ <span class="bg-gradient-to-r from-green-400 via-sky-400 to-purple-400 bg-clip-text text-transparent">სწავლის გზები</span>
    </h1>
    <p class="text-[var(--color-text-muted)] max-w-md mx-auto">
      აირჩიე შენი დონე და მიჰყევი სტრუქტურირებულ გზას. ყოველი ნაბიჯი გაძლიერებს შენს ინგლისურს.
    </p>
    <div class="flex justify-center gap-3 mt-4">
      <span class="text-xs bg-green-500/15 text-green-400 px-3 py-1 rounded-full font-semibold">🌱 დამწყები</span>
      <span class="text-xs bg-sky-500/15 text-sky-400 px-3 py-1 rounded-full font-semibold">📚 საშუალო</span>
      <span class="text-xs bg-purple-500/15 text-purple-400 px-3 py-1 rounded-full font-semibold">🎓 მაღალი</span>
    </div>
  </section>

  <!-- Paths -->
  <section class="max-w-2xl mx-auto px-4 pb-24 space-y-6">
    {paths.map((path, pathIdx) => (
      <div class="path-card" data-path-id={path.id}>
        <div class="path-header" data-toggle={path.id}>
          <div class="flex items-center gap-4">
            <div class={`progress-ring`} data-ring={path.id}>
              <svg viewBox="0 0 64 64" class="w-full h-full">
                <circle cx="32" cy="32" r="28" fill="none" stroke="#2e2e32" stroke-width="4" />
                <circle cx="32" cy="32" r="28" fill="none" stroke="url(#grad-{path.id})" stroke-width="4"
                  stroke-dasharray="175.93" stroke-dashoffset="175.93" stroke-linecap="round"
                  transform="rotate(-90 32 32)" data-progress-circle={path.id} />
                <defs>
                  <linearGradient id={`grad-${path.id}`} x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color={path.id === 'beginner' ? '#4ade80' : path.id === 'intermediate' ? '#38bdf8' : '#c084fc'} />
                    <stop offset="100%" stop-color={path.id === 'beginner' ? '#10b981' : path.id === 'intermediate' ? '#6366f1' : '#ec4899'} />
                  </linearGradient>
                </defs>
                <text x="32" y="36" text-anchor="middle" fill="white" font-size="14" font-weight="800" data-progress-text={path.id}>0%</text>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`text-xs font-bold ${path.textColor} bg-white/10 px-2 py-0.5 rounded-full`}>{path.level}</span>
                <span class="text-xs text-[var(--color-text-muted)]">{path.duration}</span>
              </div>
              <h2 class="text-lg font-bold">{path.icon} {path.title}</h2>
              <p class="text-xs text-[var(--color-text-muted)] mt-0.5 line-clamp-2">{path.desc}</p>
            </div>
            <div class="chevron" data-chevron={path.id}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
        </div>
        <div class="path-body" data-body={path.id}>
          {path.milestones.map((m, i) => {
            const isLast = i === path.milestones.length - 1;
            const tag = m.link ? 'a' : 'div';
            return m.link ? (
              <a href={m.link} class="milestone-item" data-milestone={`${path.id}-${i}`} data-storage-key={m.storageKey || ''} data-type={m.type} data-threshold={m.threshold || ''}>
                <div class="milestone-dot relative" data-dot={`${path.id}-${i}`}>
                  {m.emoji}
                  {!isLast && <div class="milestone-connector" data-connector={`${path.id}-${i}`}></div>}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-sm font-semibold">{m.title}</span>
                    <span class={`type-badge type-${m.type}`}>{m.type}</span>
                  </div>
                  <p class="text-xs text-[var(--color-text-muted)]">{m.desc}</p>
                </div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-text-muted)] flex-shrink-0 mt-1"><path d="M9 18l6-6-6-6"/></svg>
              </a>
            ) : (
              <div class="milestone-item" data-milestone={`${path.id}-${i}`} data-storage-key={m.storageKey || ''} data-type={m.type} data-threshold={m.threshold || ''}>
                <div class="milestone-dot relative" data-dot={`${path.id}-${i}`}>
                  {m.emoji}
                  {!isLast && <div class="milestone-connector" data-connector={`${path.id}-${i}`}></div>}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-sm font-semibold">{m.title}</span>
                    <span class={`type-badge type-${m.type}`}>{m.type}</span>
                  </div>
                  <p class="text-xs text-[var(--color-text-muted)]">{m.desc}</p>
                </div>
              </div>
            );
          })}
          <div class="p-4 text-center border-t border-[#2e2e32]">
            <span class={`text-xs font-semibold ${path.textColor}`} data-path-status={path.id}>დაიწყე სწავლა!</span>
          </div>
        </div>
      </div>
    ))}

    <!-- CTA -->
    <div class="text-center pt-4">
      <p class="text-sm text-[var(--color-text-muted)] mb-3">არ იცი შენი დონე?</p>
      <a href="/placement/" class="inline-block px-6 py-3 rounded-2xl bg-gradient-to-r from-green-500 to-emerald-500 text-white font-bold border-b-4 border-green-700 hover:brightness-110 active:border-b-2 active:mt-[2px] transition-all">
        🎯 გაიარე დონის ტესტი
      </a>
    </div>
  </section>

  <script is:inline>
    (function() {
      // Toggle path expand/collapse
      document.querySelectorAll('[data-toggle]').forEach(function(header) {
        header.addEventListener('click', function() {
          var id = this.getAttribute('data-toggle');
          var body = document.querySelector('[data-body="' + id + '"]');
          var chevron = document.querySelector('[data-chevron="' + id + '"]');
          body.classList.toggle('open');
          chevron.classList.toggle('open');
        });
      });

      // Auto-expand first path
      var firstBody = document.querySelector('[data-body="beginner"]');
      var firstChevron = document.querySelector('[data-chevron="beginner"]');
      if (firstBody) { firstBody.classList.add('open'); firstChevron.classList.add('open'); }

      // Check placement level and auto-expand appropriate path
      var level = localStorage.getItem('fluentge-placement-level');
      if (level) {
        var pathMap = { 'A1': 'beginner', 'A2': 'beginner', 'B1': 'intermediate', 'B2': 'intermediate', 'C1': 'advanced' };
        var targetPath = pathMap[level];
        if (targetPath && targetPath !== 'beginner') {
          // Close beginner, open target
          firstBody.classList.remove('open');
          firstChevron.classList.remove('open');
          var targetBody = document.querySelector('[data-body="' + targetPath + '"]');
          var targetChevron = document.querySelector('[data-chevron="' + targetPath + '"]');
          if (targetBody) { targetBody.classList.add('open'); targetChevron.classList.add('open'); }
        }
      }

      // Track progress for each milestone
      var grammarCompleted = {};
      try { grammarCompleted = JSON.parse(localStorage.getItem('fluentge-grammar-completed') || '{}'); } catch(e) {}

      var learnedWords = new Set();
      for (var i = 0; i < localStorage.length; i++) {
        var key = localStorage.key(i);
        if (key && key.startsWith('fluentge-srs-')) {
          try {
            var srsData = JSON.parse(localStorage.getItem(key));
            if (srsData && typeof srsData === 'object') {
              Object.keys(srsData).forEach(function(w) {
                if (srsData[w] && srsData[w].repetitions >= 1) learnedWords.add(w);
              });
            }
          } catch(e) {}
        }
      }
      try {
        var kc = JSON.parse(localStorage.getItem('knownCards') || '[]');
        kc.forEach(function(w) { learnedWords.add(w); });
      } catch(e) {}
      var totalWords = learnedWords.size;

      // Check each milestone
      var pathProgress = { beginner: 0, intermediate: 0, advanced: 0 };
      var pathTotals = { beginner: 0, intermediate: 0, advanced: 0 };

      document.querySelectorAll('[data-milestone]').forEach(function(el) {
        var id = el.getAttribute('data-milestone');
        var pathId = id.split('-')[0];
        var type = el.getAttribute('data-type');
        var storageKey = el.getAttribute('data-storage-key');
        var threshold = parseInt(el.getAttribute('data-threshold') || '0');
        var dot = document.querySelector('[data-dot="' + id + '"]');
        var connector = document.querySelector('[data-connector="' + id + '"]');
        var completed = false;

        pathTotals[pathId] = (pathTotals[pathId] || 0) + 1;

        if (type === 'grammar' && storageKey) {
          completed = storageKey in grammarCompleted;
        } else if (type === 'vocab' && storageKey) {
          // Check if user has studied any cards from this deck
          var srsStore = localStorage.getItem('fluentge-srs-' + storageKey);
          if (srsStore) {
            try {
              var data = JSON.parse(srsStore);
              var studied = Object.keys(data).filter(function(k) { return data[k] && data[k].repetitions >= 1; });
              completed = studied.length >= 3; // at least 3 words studied
            } catch(e) {}
          }
        } else if (type === 'milestone') {
          completed = totalWords >= threshold;
        }
        // podcast, quiz, game, writing — harder to track, leave unchecked

        if (completed) {
          pathProgress[pathId] = (pathProgress[pathId] || 0) + 1;
          if (dot) dot.classList.add('completed');
          if (connector) connector.classList.add('completed');
        }
      });

      // Update progress rings
      ['beginner', 'intermediate', 'advanced'].forEach(function(pathId) {
        var total = pathTotals[pathId] || 1;
        var done = pathProgress[pathId] || 0;
        var pct = Math.round((done / total) * 100);
        var circle = document.querySelector('[data-progress-circle="' + pathId + '"]');
        var text = document.querySelector('[data-progress-text="' + pathId + '"]');
        var status = document.querySelector('[data-path-status="' + pathId + '"]');
        if (circle) {
          var circumference = 175.93;
          var offset = circumference - (pct / 100) * circumference;
          circle.setAttribute('stroke-dashoffset', offset.toString());
        }
        if (text) text.textContent = pct + '%';
        if (status) {
          if (pct >= 100) status.textContent = '🏆 დასრულებული!';
          else if (pct > 0) status.textContent = done + '/' + total + ' დასრულებული';
          else status.textContent = 'დაიწყე სწავლა!';
        }
      });
    })();
  </script>
</Layout>
